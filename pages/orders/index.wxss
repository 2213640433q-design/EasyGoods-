page { 
  height: 100vh; 
  background:#F8F9FA; 
}

.page { 
  display: flex; 
  flex-direction: column; 
  height: 100vh; 
  background:#F8F9FA; 
}

/* 顶部导航栏 */
.topbar {
  position: relative;
  background: #FFF;
  border-bottom: 1px solid #F2F2F7;
  z-index: 1100;
  box-sizing: border-box;
}

.topbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  height: 44px;
}

.nav-left, .nav-right {
  width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back {
  font-size: 28px;
  color: #1D1D1F;
  line-height: 1;
  font-weight: 300;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
}
/* 筛选项 - 横向滚动容器 */
.filters-container {
  width: 100%;
  height: 56px;
  background: #FFF;
  border-bottom: 1px solid #F2F2F7;
  white-space: nowrap;
  box-sizing: border-box;
}

/* 隐藏滚动条 */
.filters-container::-webkit-scrollbar {
  display: none;
}

/* 筛选项内层包装 */
.filters-wrapper {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
  padding: 0 16px;
  white-space: nowrap;
}

/* 筛选项样式 */
.filter {
  display: inline-flex;
  align-items: center;
  padding: 7px 18px;
  background: #F1F3F5;
  border-radius: 6px;
  font-size: 13px;
  color: #1D1D1F;
  margin-right: 10px;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
  line-height: 1.4;
  vertical-align: middle;
}

.filter:last-child {
  margin-right: 0;
}

.filter.active {
  background: #4A6FA5;
  color: #FFF;
  font-weight: 500;
  box-shadow: 0 2px 8px rgba(74, 111, 165, 0.3);
}

/* 筛选项中的数量文字 */
.filter-count {
  font-size: 13px;
  font-weight: 400;
  margin-left: 2px;
}

/* 激活状态下的数量也显示为白色 */
.filter.active .filter-count {
  color: #FFF;
}
/* 列表容器 - 用于触摸事件 */
.list-container {
  flex: 1;
  height: 100%;
  overflow: hidden;
  position: relative;
}

/* 优化后的 .list 样式 */
.list { 
  flex: 1; 
  height: 100%; 
  padding: 12px 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20px);
  will-change: transform, opacity;
}

/* 优化后的 .item 样式 */
.item { 
  background:#FFF; 
  border-radius:10px; 
  padding:12px; 
  margin: 0 12px 10px 12px; /* 新增左右 margin 12px 来模拟列表的间距 */
}

/* 设备名称 + 订单状态 */
.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 6px;
}
.status { 
  font-size:12px;
  flex-shrink: 0;
  font-weight: 500;
  line-height: 1.4;
}

/* 中间：商品图片 + 信息 */
.item-body {
  display: flex;
  align-items: flex-start; /* 顶部对齐 */
  margin-bottom: 12px;
}

/* 左侧：商品图片 */
.product-image {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #F8F9FA;
  margin-right: 16px; /* 图片和文字间距 */
}

/* 右侧：商品信息 */
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start; /* 从顶部开始排列 */
  min-width: 0;
}

.product-title { 
  flex: 1;
  font-size:15px; 
  font-weight:600; 
  color:#1D1D1F; 
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-width: 0;
}

/* 订单状态颜色 - 仅2种颜色 */
/* 活跃状态 - 蓝色（与归还时间颜色统一） */
.status-pending,
.status-paid,
.status-picked,
.status-checking { 
  color: #4A6FA5; /* 蓝色 - 活跃订单 */
}

/* 已完成状态 - 灰色 */
.status-completed,
.status-returning,
.status-processing,
.status-shipped,
.status-refund {
  color: #8E8E93; /* 灰色 - 已完成/其他 */
}

/* 信息行：门店、位置、时间 */
.info-row { 
  display: flex; 
  align-items: flex-start;
  font-size: 12px;
  line-height: 1.5;
  margin-bottom: 4px; /* 信息行之间的间距 */
}
.info-row:last-child {
  margin-bottom: 0; /* 最后一行不需要下边距 */
}
.info-label { 
  color: #8E8E93; 
  flex-shrink: 0;
}
.info-value { 
  flex: 1;
  color: #4D4D4D;
  word-break: break-all;
}

/* 时间信息高亮（租赁） */
.info-row.highlight {
  margin-top: 2px;
}
.info-value.time { 
  color: #4A6FA5; 
  font-weight: 500;
}

/* 订单编号样式 */
.info-value.order-id {
  font-size: 12px;
  color: #8E8E93;
  font-family: 'Courier New', monospace;
}

/* 底部：金额 + 按钮 */
.item-footer { 
  display:flex; 
  align-items:center; 
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid #F2F2F7;
}
.amount {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  flex: 1;
}
.btn { 
  background:#EEF3F8; 
  color:#1D1D1F; 
  border: none; 
  font-size: 12px;
  font-weight: normal;
  padding: 6px 16px;
  flex-shrink: 0;
  line-height: 1.4;
  border-radius: 16px;
  margin-left: 12px;
}

.btn-primary {
  background: #4A6FA5;
  color: #FFF;
  font-weight: 500;
}
