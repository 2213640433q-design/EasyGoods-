page, .page { min-height: 100vh; background:#F8F9FA; }
.topbar { position: fixed; top:0; left:0; right:0; display:flex; align-items:center; justify-content:space-between; padding:10px 16px; background:#FFF; border-bottom:1px solid #F2F2F7; z-index:1000; }
.nav-left, .nav-right { width: 60px; }
.back { font-size:24px; color:#1D1D1F; }
.title { flex:1; text-align:center; font-size:16px; font-weight:600; color:#1D1D1F; }
.content { margin-top: calc(44px + env(safe-area-inset-top)); padding:12px 16px; }
.section { background:#FFF; border-radius:10px; padding:16px; margin-bottom:12px; }
.h1 { display:block; font-size:15px; font-weight:600; color:#1D1D1F; margin-bottom:8px; }
.p { display:block; font-size:14px; color:#4B5563; line-height:1.6; white-space:pre-wrap; }
.bottom-space { height: 20px; }


