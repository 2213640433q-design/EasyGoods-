page, .page { min-height: 100vh; background:#F8F9FA; }
.topbar { position: fixed; top:0; left:0; right:0; display:flex; align-items:center; justify-content:space-between; padding:10px 16px; background:#FFF; border-bottom:1px solid #F2F2F7; z-index:1000; }
.nav-left, .nav-right { width: 60px; }
.back { font-size:24px; color:#1D1D1F; }
.title { flex:1; text-align:center; font-size:16px; font-weight:600; color:#1D1D1F; }
.content { margin-top: calc(44px + env(safe-area-inset-top)); padding:12px 16px; }
.brand { display:flex; flex-direction:column; align-items:center; margin: 8px 0 16px; }
.brand-logo { width: 56px; height: 56px; border-radius: 12px; margin-bottom: 6px; }
.brand-name { font-size: 14px; color:#1D1D1F; font-weight:600; margin-bottom: 4px; }
.brand-version { font-size: 12px; color:#6B7280; }
.card { background:#FFF; border-radius:10px; padding:16px; margin-bottom:12px; }
.card-title { font-size:15px; font-weight:600; color:#1D1D1F; display:block; margin-bottom:8px; }
.card-text { font-size:14px; color:#4B5563; white-space:pre-wrap; line-height:1.6; }
.list { background:#FFF; border-radius:10px; overflow:hidden; }
.list-item { display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid #F2F2F7; }
.list-item:last-child { border-bottom:none; }
.list-text { font-size:14px; color:#1D1D1F; }
.arrow { font-size:20px; color:#8E8E93; }
.bottom-space { height: 20px; }

