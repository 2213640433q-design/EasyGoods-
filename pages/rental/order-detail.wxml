<view class="page">
  <!-- 顶部导航栏 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">订单详情</view>
    <view class="nav-right"></view>
  </view>

  <!-- 滚动内容区域 -->
  <scroll-view class="content" scroll-y>
    <!-- 订单状态进度条 -->
    <view class="progress-section">
      <view class="progress-title">订单状态</view>
      <view class="progress-bar">
        <view class="progress-step {{currentStep >= 1 ? 'active' : ''}}" wx:for="{{progressSteps}}" wx:key="id" wx:for-item="step" wx:for-index="idx">
          <view class="step-dot {{currentStep > idx + 1 ? 'completed' : ''}} {{currentStep === idx + 1 ? 'current' : ''}}">
            <text class="step-icon" wx:if="{{currentStep > idx + 1}}">✓</text>
          </view>
          <view class="step-line" wx:if="{{idx < progressSteps.length - 1}}"></view>
          <view class="step-label">
            <text class="step-name">{{step.name}}</text>
            <text class="step-time" wx:if="{{step.time}}">{{step.time}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 🎫 待取件票据样式（仅待取件状态显示） -->
    <view class="ticket-section" wx:if="{{orderStatus === 'paid'}}">
      <!-- 票据卡片 -->
      <view class="ticket-card">
        <!-- 上半部分：商品和租赁信息 -->
        <view class="ticket-top">
          <!-- 上部：产品信息 + 图片（3行） -->
          <view class="ticket-product-info">
            <view class="ticket-product-left">
              <!-- 第1行：商品名称 -->
              <text class="ticket-product-name">{{productName}}</text>
              
              <!-- 第2行：类目标签 -->
              <view class="ticket-category-row">
                <text class="category-tag primary">{{mainCategory}}</text>
                <text class="category-tag secondary">{{subCategory}}</text>
              </view>
              
              <!-- 第3行：配件信息 -->
              <view class="ticket-accessories-row">
                <text class="accessories-label">配件：</text>
                <text class="accessories-value">{{accessoriesText}}</text>
              </view>
            </view>
            
            <!-- 右侧商品图片（仅对齐前3行） -->
            <view class="ticket-product-right">
              <image class="ticket-product-image" src="{{productImage}}" mode="aspectFill" />
            </view>
          </view>
          
          <!-- 下部：预约信息（全宽独立展示） -->
          <view class="ticket-appointment-info">
            <!-- 第4行：取件时间 + 租期 -->
            <view class="ticket-time-row">
              <view class="time-item">
                <text class="time-label">取件时间：</text>
                <text class="time-value">{{rentalStartDate}}</text>
              </view>
              <view class="time-item">
                <text class="duration-label">租期：</text>
                <text class="duration-value">{{rentalDays}}天</text>
              </view>
            </view>
            
            <!-- 第5行：取件地点 + 操作按钮 -->
            <view class="ticket-location-row">
              <text class="location-label">取件地点：</text>
              <text class="location-value">{{storeName}} | {{storePostcode}}</text>
              <text class="location-divider">|</text>
              <image class="location-action-icon copy" src="/static/icons/ticket/copy.svg" mode="aspectFit" bindtap="onCopyLocation" />
              <image class="location-action-icon phone" src="/static/icons/ticket/phone.svg" mode="aspectFit" bindtap="onCallStore" />
            </view>
          </view>
        </view>
        
        <!-- 虚线分隔 -->
        <view class="ticket-divider">
          <view class="ticket-divider-line"></view>
        </view>
        
        <!-- 下半部分：展开取件码 -->
        <view class="ticket-bottom">
          <view class="ticket-expand-btn" bindtap="toggleQRCode">
            <text class="ticket-expand-text">{{showQRCode ? '收起取件码' : '展开取件码'}}</text>
            <text class="ticket-expand-icon">{{showQRCode ? '︿' : '﹀'}}</text>
          </view>
          
          <!-- 取件凭证区域（展开后显示） -->
          <view class="ticket-qrcode-container" wx:if="{{showQRCode}}">
            <view class="ticket-qrcode-title">取件凭证</view>
            
            <!-- 小程序码显示区域 -->
            <view class="qrcode-wrapper">
              <image 
                wx:if="{{qrcodeUrl}}"
                class="qrcode-image" 
                src="{{qrcodeUrl}}" 
                mode="aspectFit"
              />
              <view wx:else class="qrcode-loading">
                <text class="loading-text">二维码生成中...</text>
              </view>
            </view>
            
            <view class="ticket-qrcode-tip">
              <text>请向工作人员出示此二维码</text>
            </view>
            
            <view class="ticket-order-code">
              <text class="code-label">订单号：</text>
              <text class="code-value">{{orderId}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 取件提示 -->
      <view class="ticket-notice">
        <text class="ticket-notice-icon">💡</text>
        <text class="ticket-notice-text">请在预约时间到店，向工作人员出示取件二维码</text>
      </view>
    </view>

    <!-- 🎫 租赁中票据样式（仅租赁中状态显示） -->
    <view class="ticket-section" wx:if="{{orderStatus === 'picked'}}">
      <!-- 票据卡片 -->
      <view class="ticket-card">
        <!-- 上半部分：商品和租赁信息 -->
        <view class="ticket-top">
          <!-- 上部：产品信息 + 图片（3行） -->
          <view class="ticket-product-info">
            <view class="ticket-product-left">
              <!-- 第1行：商品名称 -->
              <text class="ticket-product-name">{{productName}}</text>
              
              <!-- 第2行：类目标签 -->
              <view class="ticket-category-row">
                <text class="category-tag primary">{{mainCategory}}</text>
                <text class="category-tag secondary">{{subCategory}}</text>
              </view>
              
              <!-- 第3行：配件信息 -->
              <view class="ticket-accessories-row">
                <text class="accessories-label">配件：</text>
                <text class="accessories-value">{{accessoriesText}}</text>
              </view>
            </view>
            
            <!-- 右侧商品图片（仅对齐前3行） -->
            <view class="ticket-product-right">
              <image class="ticket-product-image" src="{{productImage}}" mode="aspectFill" />
            </view>
          </view>
          
          <!-- 下部：预约信息（全宽独立展示） -->
          <view class="ticket-appointment-info">
            <!-- 第4行：归还时间 + 租期 -->
            <view class="ticket-time-row">
              <view class="time-item">
                <text class="time-label">归还时间：</text>
                <text class="time-value">{{rentalEndDate}}</text>
              </view>
              <view class="time-item">
                <text class="duration-label">租期：</text>
                <text class="duration-value">{{rentalDays}}天</text>
              </view>
            </view>
            
            <!-- 第5行：归还地点 + 操作按钮 -->
            <view class="ticket-location-row">
              <text class="location-label">归还地点：</text>
              <text class="location-value">{{storeName}} | {{storePostcode}}</text>
              <text class="location-divider">|</text>
              <image class="location-action-icon copy" src="/static/icons/ticket/copy.svg" mode="aspectFit" bindtap="onCopyLocation" />
              <image class="location-action-icon phone" src="/static/icons/ticket/phone.svg" mode="aspectFit" bindtap="onCallStore" />
            </view>
          </view>
        </view>
        
        <!-- 虚线分隔 -->
        <view class="ticket-divider">
          <view class="ticket-divider-line"></view>
        </view>
        
        <!-- 下半部分：展开归还码 -->
        <view class="ticket-bottom">
          <view class="ticket-expand-btn" bindtap="toggleReturnQRCode">
            <text class="ticket-expand-text">{{showReturnQRCode ? '收起归还码' : '展开归还码'}}</text>
            <text class="ticket-expand-icon">{{showReturnQRCode ? '︿' : '﹀'}}</text>
          </view>
          
          <!-- 归还凭证区域（展开后显示） -->
          <view class="ticket-qrcode-container" wx:if="{{showReturnQRCode}}">
            <view class="ticket-qrcode-title">归还凭证</view>
            
            <!-- 小程序码显示区域 -->
            <view class="qrcode-wrapper">
              <image 
                wx:if="{{returnQrcodeUrl}}"
                class="qrcode-image" 
                src="{{returnQrcodeUrl}}" 
                mode="aspectFit"
              />
              <view wx:else class="qrcode-loading">
                <text class="loading-text">二维码生成中...</text>
              </view>
            </view>
            
            <view class="ticket-qrcode-tip">
              <text>归还时请向工作人员出示此二维码</text>
            </view>
            
            <view class="ticket-order-code">
              <text class="code-label">订单号：</text>
              <text class="code-value">{{orderId}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 归还提示 -->
      <view class="ticket-notice">
        <text class="ticket-notice-icon">💡</text>
        <text class="ticket-notice-text">请在租期到期前归还设备，向工作人员出示归还二维码</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="order-info-section">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{orderId}}</text>
      </view>
      <view class="info-row" wx:if="{{createTime}}">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{createTime}}</text>
      </view>
      <view class="info-row" wx:if="{{payTime}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{payTime}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单状态</text>
        <text class="info-value status-text">{{orderStatusText}}</text>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="price-section">
      <view class="section-title">费用明细</view>
      <view class="price-row">
        <text class="price-label">器材租金</text>
        <text class="price-value">£{{equipmentPrice}}</text>
      </view>
      <view class="price-row" wx:if="{{accessoriesPrice > 0}}">
        <text class="price-label">配件费用</text>
        <text class="price-value">£{{accessoriesPrice}}</text>
      </view>
      <!-- 🎟️ 优惠券（如果使用了） -->
      <view class="price-row discount-row" wx:if="{{couponDiscount > 0}}">
        <text class="price-label">优惠券</text>
        <text class="price-value discount">-£{{couponDiscount}}</text>
      </view>
      <view class="price-row subtotal">
        <text class="price-label-subtotal">小计</text>
        <text class="price-value-subtotal">£{{totalPrice}}</text>
      </view>
      <!-- 押金行（黄色背景） -->
      <view class="price-row deposit-row">
        <view class="deposit-label-with-note">
          <text class="price-label">器材押金</text>
          <text class="deposit-note-inline">（订单完成后退还）</text>
        </view>
        <text class="price-value">£{{deposit}}</text>
      </view>
    </view>


    <!-- 备注 -->
    <view class="note-section" wx:if="{{note}}">
      <view class="section-title">备注</view>
      <view class="note-content">{{note}}</view>
    </view>

    <view class="bottom-placeholder"></view>
  </scroll-view>

  <!-- 底部栏 -->
  <view class="bottom-bar" style="padding-bottom: calc(env(safe-area-inset-bottom) / 2 + 2px);">
    <view class="bottom-left">
      <text class="pay-label">订单总额</text>
      <view class="pay-amount-row">
        <text class="pay-amount">£{{totalAmount}}</text>
        <text class="pay-detail">（租金£{{totalPrice}}+押金£{{deposit}}）</text>
      </view>
    </view>
    
    <!-- 🚫 根据订单状态显示不同的按钮 -->
    
    <!-- 待支付状态：显示取消订单 + 继续支付按钮 -->
    <view class="bottom-buttons" wx:if="{{orderStatus === 'pending'}}">
      <view class="cancel-order-btn" bindtap="openCancelSheet">
        <text>取消订单</text>
      </view>
      <view class="pay-now-btn" bindtap="onPayNow">
        <text>继续支付</text>
      </view>
    </view>
    
    <!-- 待取件状态：只显示取消订单按钮 -->
    <view class="bottom-buttons" wx:elif="{{orderStatus === 'paid'}}">
      <view class="cancel-order-btn" bindtap="openCancelSheet">
        <text>取消订单</text>
      </view>
    </view>
    
    <!-- 租赁中状态：显示续租链接 + 状态 -->
    <view class="bottom-buttons renew-bar" wx:elif="{{orderStatus === 'picked'}}">
      <view class="renew-link" bindtap="onRenewOrder">
        <text>一键续租</text>
      </view>
      <view class="order-info-btn renting">
        <text>{{orderStatusText}}</text>
      </view>
    </view>
    
    <!-- 其他状态：显示订单状态 -->
    <view class="order-info-btn" wx:else>
      <text>{{orderStatusText}}</text>
    </view>
  </view>
  
  <!-- 🔄 全屏续租日历选择器 -->
  <view class="renew-calendar-modal" wx:if="{{showRenewModal}}">
    <view class="calendar-container">
      <!-- 日历头部 -->
      <view class="calendar-header">
        <view class="header-back" bindtap="closeRenewModal">
          <text class="back-icon">‹</text>
        </view>
        <text class="header-title">选择续租日期</text>
        <view class="header-placeholder"></view>
      </view>

      <!-- 当前归还时间提示 -->
      <view class="current-end-tip">
        <text class="tip-label">当前归还时间：</text>
        <text class="tip-value">{{rentalEndDate}}</text>
        <text class="tip-hint">（请从此日期后选择）</text>
      </view>

      <!-- 月份切换器 -->
      <view class="month-switcher">
        <view class="month-prev" bindtap="prevMonth">‹</view>
        <text class="month-display">{{currentYear}}年{{currentMonth}}月</text>
        <view class="month-next" bindtap="nextMonth">›</view>
      </view>

      <!-- 星期标题 -->
      <view class="weekday-header">
        <view class="weekday-item">日</view>
        <view class="weekday-item">一</view>
        <view class="weekday-item">二</view>
        <view class="weekday-item">三</view>
        <view class="weekday-item">四</view>
        <view class="weekday-item">五</view>
        <view class="weekday-item">六</view>
      </view>

      <!-- 日历网格 -->
      <view class="calendar-grid">
        <view 
          class="date-item {{item.isDisabled ? 'disabled' : ''}}" 
          wx:for="{{calendarDates}}" 
          wx:key="dateKey"
          data-date="{{item.dateStr}}"
          bindtap="onSelectRenewDate"
        >
          <view class="date-number {{item.isToday ? 'is-today' : ''}} {{item.isSelected ? 'is-selected' : ''}} {{item.isDisabled ? 'is-disabled' : ''}}">
            {{item.day}}
          </view>
          <view wx:if="{{item.isSelected}}" class="date-label">新归还</view>
          <view wx:if="{{item.isToday && !item.isSelected}}" class="date-label today-label">今天</view>
        </view>
      </view>

      <!-- 底部操作栏 -->
      <view class="calendar-footer">
        <view class="selected-info">
          <view wx:if="{{renewEndDate}}" class="info-content">
            <view class="info-row">
              <text class="info-label">续租至</text>
              <text class="info-value">{{renewEndDate}}</text>
            </view>
            <view class="info-row highlight">
              <text class="info-days-text">续租{{renewDays}}天 · £{{renewPrice}}</text>
            </view>
          </view>
          <view wx:else class="info-placeholder">
            请选择续租结束日期
          </view>
        </view>
        <view class="action-buttons">
          <view class="reset-btn {{renewEndDate ? 'active' : ''}}" bindtap="resetRenewDate">
            <text class="btn-icon">↻</text>
          </view>
          <view class="confirm-btn {{renewEndDate ? 'active' : ''}}" bindtap="confirmRenewDate">
            <text class="btn-icon">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 🚫 取消订单原因选择弹窗 -->
  <view class="cancel-sheet-mask" wx:if="{{showCancelReasonSheet}}" bindtap="closeCancelSheet"></view>
  <view class="cancel-sheet {{showCancelReasonSheet ? 'show' : ''}}">
    <view class="cancel-sheet-header">
      <text class="cancel-sheet-title">选择取消原因</text>
      <view class="cancel-sheet-close" bindtap="closeCancelSheet">
        <text>×</text>
      </view>
    </view>
    <view class="cancel-sheet-content">
      <view class="cancel-reason-item" 
            wx:for="{{cancelReasons}}" 
            wx:key="*this"
            data-reason="{{item}}"
            bindtap="onSelectCancelReason">
        <text class="reason-text">{{item}}</text>
        <text class="reason-arrow">›</text>
      </view>
    </view>
  </view>
</view>

