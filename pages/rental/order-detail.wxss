/* 全局盒模型修正 */
page, view, text, image {
  box-sizing: border-box;
}

page, .page { 
  min-height: 100vh; 
  background: #F8F9FA; 
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.topbar { 
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  padding: 10px 16px; 
  background: #FFF; 
  border-bottom: 1px solid #F2F2F7;
  z-index: 1000;
}

.nav-left, .nav-right { 
  width: 60px; 
}

.back-icon { 
  font-size: 28px; 
  color: #1D1D1F; 
}

.nav-title { 
  flex: 1;
  text-align: center; 
  font-size: 16px; 
  font-weight: 600; 
  color: #1D1D1F; 
}

/* 内容区域 */
.content {
  position: fixed;
  top: calc(44px + env(safe-area-inset-top));
  left: 0;
  right: 0;
  bottom: 70px;  /* 底部栏高度 */
  padding: 12px 16px 20px 16px;
  box-sizing: border-box;
  overflow-y: scroll;  /* 确保可以滚动 */
}

.bottom-placeholder {
  height: 20px;
}

/* 订单状态进度条 */
.progress-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
}

.progress-title {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 16px;
}

.progress-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.progress-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-dot {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background: #E5E7EB;
  border: 2px solid #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.step-dot.current {
  background: #4A6FA5;
  border-color: #4A6FA5;
}

.step-dot.completed {
  background: #4A6FA5;
  border-color: #4A6FA5;
}

.step-icon {
  color: #FFF;
  font-size: 16px;
  font-weight: bold;
}

.step-line {
  position: absolute;
  top: 14px;
  left: 50%;
  width: 100%;
  height: 2px;
  background: #E5E7EB;
  z-index: 1;
}

.progress-step.active .step-line {
  background: #4A6FA5;
}

.step-label {
  margin-top: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.step-name {
  font-size: 12px;
  color: #8E8E93;
  white-space: nowrap;
}

.progress-step.active .step-name {
  color: #1D1D1F;
  font-weight: 500;
}

.step-time {
  font-size: 10px;
  color: #C7C7CC;
  margin-top: 2px;
}

/* 门店信息 */
/* 订单信息区域 */
.order-info-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #F8F9FA;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 14px;
  color: #8E8E93;
  font-weight: 400;
}

.info-value {
  font-size: 14px;
  color: #1D1D1F;
  font-weight: 400;
  text-align: right;
  max-width: 60%;
  word-wrap: break-word;
}

.info-value.status-text {
  color: #4A6FA5;
  font-weight: 500;
}

.store-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.store-header {
  margin-bottom: 12px;
}

.store-name {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
}

.store-details {
  border-top: 1px solid #F2F2F7;
  padding-top: 12px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  width: 80px;
  font-size: 14px;
  color: #8E8E93;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 14px;
  color: #1D1D1F;
  text-align: left;
}

.detail-value.phone {
  color: #4A6FA5;
}

/* 商品信息 */
.product-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12px;
}

.product-card {
  display: flex;
  align-items: flex-start;
}

.product-image {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  margin-right: 12px;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.product-name {
  font-size: 14px;
  color: #1D1D1F;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 4px;
}

.product-subtitle {
  font-size: 12px;
  color: #8E8E93;
}

.accessories-row {
  border-top: 1px solid #F2F2F7;
  padding-top: 12px;
  margin-top: 12px;
  display: flex;
}

.accessories-label {
  font-size: 13px;
  color: #8E8E93;
  margin-right: 4px;
  flex-shrink: 0;
}

.accessories-text {
  flex: 1;
  font-size: 13px;
  color: #1D1D1F;
  line-height: 1.5;
}

/* 租赁信息 */
.rental-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.rental-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.rental-row:last-child {
  margin-bottom: 0;
}

.rental-label {
  font-size: 14px;
  color: #8E8E93;
}

.rental-value {
  font-size: 14px;
  color: #1D1D1F;
  text-align: left;
}

/* 续租栏 */
.renew-bar {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.renew-left { display: flex; align-items: baseline; }
.renew-label { font-size: 14px; color: #8E8E93; margin-right: 8px; }
.renew-date { font-size: 14px; color: #1D1D1F; }
.renew-btn { background: #4A6FA5; color: #FFF; border-radius: 16px; padding: 6px 12px; font-size: 13px; font-weight: 600; }

/* 费用明细 */
.price-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.price-row:last-child {
  margin-bottom: 0;
}

.price-label {
  font-size: 14px;
  color: #1D1D1F;
}

.price-value {
  font-size: 14px;
  color: #1D1D1F;
  text-align: right;
}

/* 🎟️ 优惠券折扣行 */
.price-row.discount-row {
  margin-bottom: 8px;
}

.price-value.discount {
  color: #FF6B6B;
  font-weight: 500;
}

/* 小计行 */
.price-row.subtotal {
  padding-top: 10px;
  border-top: 1px solid #F2F2F7;
  margin-top: 10px;
  margin-bottom: 10px;
}

.price-label-subtotal {
  font-size: 14px;
  color: #1D1D1F;
  font-weight: 500;
}

.price-value-subtotal {
  font-size: 14px;
  color: #1D1D1F;
  font-weight: 500;
}

/* 押金行（黄色背景） */
.price-row.deposit-row {
  background: #FFF9E6;
  margin: 10px -16px -16px -16px;
  padding: 12px 16px;
  border-radius: 0 0 10px 10px;
}

.deposit-label-with-note {
  display: flex;
  align-items: center;
  gap: 6px;
}

.deposit-note-inline {
  font-size: 11px;
  color: #F59E0B;
  font-weight: 500;
}

.price-row.total {
  padding-top: 10px;
  border-top: 1px solid #F2F2F7;
  margin-top: 10px;
}

.price-label-total {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F;
}

.price-value-total {
  font-size: 18px;
  font-weight: 600;
  color: #FF6B6B;
  text-align: right;
}

/* 押金信息 */
.deposit-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.deposit-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.deposit-label {
  font-size: 14px;
  color: #1D1D1F;
}

.deposit-value {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  text-align: right;
}

.deposit-note {
  font-size: 12px;
  color: #8E8E93;
  line-height: 1.4;
  margin-top: 8px;
}

/* 备注 */
.note-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box;
}

.note-content {
  font-size: 14px;
  color: #1D1D1F;
  line-height: 1.6;
  background: #F8F9FA;
  border-radius: 8px;
  padding: 12px;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFF;
  border-top: 1px solid #F2F2F7;
  padding: 8px 16px;
  display: flex;
  /* 删除 flex-direction: column; 使用默认的 row */
  align-items: center; /* 垂直居中 */
  justify-content: space-between; /* 两端对齐 */
  z-index: 1000;
  box-sizing: border-box;
}

.bottom-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  flex: 1;
  min-width: 0;
}

.pay-label {
  font-size: 12px;
  color: #8E8E93;
  font-weight: 400;
  line-height: 1;
}

.pay-amount-row {
  display: flex;
  align-items: baseline; /* 按基线对齐，让文字底部对齐 */
  gap: 6px;
}

.pay-amount {
  font-size: 22px;
  font-weight: 700;
  color: #FF3B30;
  line-height: 1;
  white-space: nowrap;
}

.pay-detail {
  font-size: 11px;
  color: #8E8E93;
  font-weight: 400;
  white-space: nowrap;
  line-height: 1;
}

.order-info-btn {
  background: #F2F2F7;
  color: #8E8E93;
  border-radius: 20px;
  padding: 12px 32px;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap; /* 文字不换行 */
  flex-shrink: 0;
}

/* 🚫 取消订单按钮容器 */
.bottom-buttons {
  display: flex;
  gap: 12px;
}

/* 🔄 续租栏 */
.bottom-buttons.renew-bar {
  display: flex;
  align-items: center;
  gap: 10px; /* 续租链接和按钮之间的间距 */
  flex-wrap: nowrap;
  flex-shrink: 0;
}

.renew-link {
  color: #2E5A9B;
  font-size: 13px; /* 再缩小字体 */
  font-weight: 500;
  padding: 4px 8px;
  cursor: pointer;
  transition: opacity 0.2s;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.2;
}

.renew-link:active {
  opacity: 0.6;
}

.order-info-btn.renting {
  flex: 0 0 auto;
  font-size: 13px; /* 再缩小字体 */
  padding: 8px 20px; /* 再缩小内边距 */
  white-space: nowrap;
  line-height: 1.2;
}

/* 🚫 取消订单按钮 */
.cancel-order-btn {
  background: #FFF;
  color: #FF3B30;
  border: 1px solid #FF3B30;
  border-radius: 20px;
  padding: 12px 24px;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex: 1;
}

.cancel-order-btn:active {
  background: #FFF5F4;
  transform: scale(0.98);
}

/* 💳 继续支付按钮 */
.pay-now-btn {
  background: #4A6FA5;
  color: #FFF;
  border: 1px solid #4A6FA5;
  border-radius: 20px;
  padding: 12px 24px;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  flex: 1;
}

.pay-now-btn:active {
  background: #3D5D8C;
  transform: scale(0.98);
}

/* 🚫 取消订单弹窗遮罩 */
.cancel-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 🚫 取消订单弹窗 */
.cancel-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF;
  border-radius: 20px 20px 0 0;
  z-index: 2001;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}

.cancel-sheet.show {
  transform: translateY(0);
}

/* 🚫 弹窗头部 */
.cancel-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 16px;
  border-bottom: 1px solid #F2F2F7;
}

.cancel-sheet-title {
  font-size: 17px;
  font-weight: 600;
  color: #1D1D1F;
}

.cancel-sheet-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #8E8E93;
  line-height: 1;
}

/* 🚫 弹窗内容 */
.cancel-sheet-content {
  flex: 1;
  overflow-y: auto;
  padding: 8px 0;
}

/* 🚫 取消原因选项 */
.cancel-reason-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #F8F9FA;
  transition: background 0.2s;
}

.cancel-reason-item:active {
  background: #F8F9FA;
}

.reason-text {
  font-size: 15px;
  color: #1D1D1F;
  flex: 1;
}

.reason-arrow {
  font-size: 20px;
  color: #C7C7CC;
  margin-left: 8px;
}

/* ============================================
   🎫 票据样式（电影票风格）
   ============================================ */

.ticket-section {
  padding: 0 16px;
  margin-top: 12px;
}

/* 票据卡片容器 */
.ticket-card {
  background: #FFFFFF;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
  position: relative;
}

/* 票据上半部分 */
.ticket-top {
  padding: 20px;
  background: linear-gradient(135deg, #FFFFFF 0%, #F9FAFB 100%);
}

/* 产品信息区（包含图片） */
.ticket-product-info {
  display: flex;
  gap: 12px;
  align-items: flex-start; /* 顶部对齐 */
  margin-bottom: 0; /* 紧贴下方预约信息 */
}

.ticket-product-left {
  flex: 1;
  min-width: 0;
}

/* ========== 产品信息区域 ========== */

/* 第1行：商品名称 */
.ticket-product-name {
  font-size: 18px;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 10px;
  line-height: 1.4;
}

/* 第2行：类目标签 */
.ticket-category-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.category-tag {
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
}

.category-tag.primary {
  background: #E8F1FF;
  color: #2E5A9B;
}

.category-tag.secondary {
  background: #F5F5F7;
  color: #86868B;
}

/* 第3行：配件信息 */
.ticket-accessories-row {
  margin-bottom: 0; /* 去掉底部间距 */
}

.accessories-label {
  font-size: 13px;
  color: #86868B;
}

.accessories-value {
  font-size: 13px;
  color: #1D1D1F;
}

/* ========== 预约信息区域（全宽独立展示）========== */

.ticket-appointment-info {
  width: 100%; /* 全宽 */
  margin-top: 14px; /* 缩小顶部间距 */
  padding-top: 12px; /* 缩小上方内边距 */
  border-top: 1px solid #F0F0F0; /* 顶部分隔线 */
}

/* 第4行：取件时间 + 租期（同一行） */
.ticket-time-row {
  display: flex;
  align-items: center;
  gap: 32px; /* "取件时间"和"租期"之间的间距 */
  margin-bottom: 10px; /* 缩小行间距 */
}

.time-item {
  display: flex;
  align-items: center;
  gap: 2px; /* 标签和值之间的间距 */
}

.time-label {
  font-size: 13px;
  color: #86868B;
  flex-shrink: 0;
}

.time-value {
  font-size: 13px;
  color: #1D1D1F;
  font-weight: 500;
}

.duration-label {
  font-size: 13px;
  color: #2E5A9B;
  flex-shrink: 0;
}

.duration-value {
  font-size: 13px;
  color: #2E5A9B;
  font-weight: 600;
}

/* 第5行：取件地点 + 操作按钮 */
.ticket-location-row {
  display: flex;
  align-items: center;
  gap: 0; /* 去掉自动间距，手动控制 */
  margin-bottom: 0;
}

.location-label {
  font-size: 13px;
  color: #86868B;
  flex-shrink: 0;
  margin-right: 2px; /* 标签和值之间的间距 */
}

.location-value {
  font-size: 13px;
  color: #1D1D1F;
  flex: 1;
  white-space: nowrap; /* 保持一行 */
}

/* 分隔竖线 */
.location-divider {
  font-size: 12px;
  color: #D2D2D7; /* 淡灰色 */
  margin: 0 6px 0 8px; /* 左8px，右6px */
  flex-shrink: 0;
  font-weight: 300;
}

/* 操作图标（复制、电话） */
.location-action-icon {
  width: 18px;
  height: 18px;
  cursor: pointer;
  flex-shrink: 0;
  opacity: 0.8;
  transition: opacity 0.2s, transform 0.2s;
}

.location-action-icon:active {
  opacity: 1;
  transform: scale(1.2);
}

.location-action-icon.copy {
  margin-right: 10px; /* 复制和电话图标之间增大间距 */
}

.location-action-icon.phone {
  /* 电话图标样式 */
}

/* 右侧商品图片（仅对齐前3行高度） */
.ticket-product-right {
  flex-shrink: 0;
}

.ticket-product-image {
  width: 80px;
  height: 80px;
  border-radius: 10px;
  background: #F5F5F7;
}

/* 虚线分隔（模拟票据撕开效果） */
.ticket-divider {
  position: relative;
  height: 10px; /* 缩小高度，让虚线更贴近上方文字 */
  background: #FFFFFF;
  display: flex;
  align-items: center;
}

.ticket-divider-line {
  width: 100%;
  height: 1px;
  background-image: linear-gradient(
    to right,
    #D2D2D7 0%,
    #D2D2D7 50%,
    transparent 50%,
    transparent 100%
  );
  background-size: 12px 1px;
  background-repeat: repeat-x;
}

/* 左右半圆缺口（模拟票据撕口） */
.ticket-divider::before,
.ticket-divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 16px;
  height: 16px;
  background: #F5F5F7;
  border-radius: 50%;
  transform: translateY(-50%);
}

.ticket-divider::before {
  left: -8px;
}

.ticket-divider::after {
  right: -8px;
}

/* 票据下半部分 */
.ticket-bottom {
  background: #FFFFFF;
  padding: 0 20px 20px 20px;
}

/* 展开取件码按钮 */
.ticket-expand-btn {
  display: flex;
  align-items: center; /* 确保内部元素垂直居中 */
  justify-content: center; /* 确保内部元素水平居中 */
  padding: 14px 12px; /* 上下对称padding */
  cursor: pointer;
  transition: opacity 0.2s;
  min-height: 40px; /* 最小高度 */
}

.ticket-expand-btn:active {
  opacity: 0.6;
}

.ticket-expand-text {
  font-size: 15px;
  color: #2E5A9B;
  font-weight: 500;
  line-height: 1;
  margin-right: 6px;
}

.ticket-expand-icon {
  font-size: 14px;
  color: #2E5A9B;
  line-height: 1;
}

/* 二维码容器 */
.ticket-qrcode-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 0;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ticket-qrcode-title {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 20px;
  letter-spacing: 2px;
}

/* 小程序码显示区域 */
.qrcode-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  background: #FFFFFF;
  border-radius: 12px;
  margin-bottom: 16px;
  min-height: 240px;
}

.qrcode-image {
  width: 200px;
  height: 200px;
  border-radius: 8px;
}

.qrcode-loading {
  width: 200px;
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F7;
  border-radius: 8px;
  border: 2px dashed #D2D2D7;
}

.loading-text {
  font-size: 14px;
  color: #86868B;
}

.ticket-qrcode-tip {
  margin-top: 12px;
  font-size: 13px;
  color: #86868B;
  text-align: center;
}

.ticket-order-code {
  margin-top: 16px;
  padding: 10px 16px;
  background: #F5F5F7;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.code-label {
  font-size: 12px;
  color: #86868B;
}

.code-value {
  font-size: 12px;
  color: #1D1D1F;
  font-family: 'Courier New', monospace;
  font-weight: 500;
}

/* 取件提示 */
.ticket-notice {
  margin-top: 12px;
  padding: 12px 16px;
  background: #FFF9E6;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.ticket-notice-icon {
  font-size: 18px;
  flex-shrink: 0;
}

.ticket-notice-text {
  font-size: 13px;
  color: #8B7B3A;
  line-height: 1.5;
  flex: 1;
}

/* ========== 🔄 续租功能样式 ========== */

/* 续租栏 */
.bottom-buttons.renew-bar {
  align-items: center;
  justify-content: space-between;
}

.renew-link {
  color: #2E5A9B;
  font-size: 15px;
  font-weight: 500;
  padding: 8px 12px;
  cursor: pointer;
  transition: opacity 0.2s;
}

.renew-link:active {
  opacity: 0.6;
}

/* ========== 🔄 续租全屏日历样式 ========== */

.renew-calendar-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F5F5F5;
  z-index: 3000;
}

/* 当前归还时间提示 */
.current-end-tip {
  padding: 12px 20px;
  background: #FFF9E6;
  border-bottom: 1px solid #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  flex-wrap: wrap;
}

.tip-label {
  font-size: 13px;
  color: #86868B;
}

.tip-value {
  font-size: 13px;
  color: #2E5A9B;
  font-weight: 600;
}

.tip-hint {
  font-size: 12px;
  color: #86868B;
}

/* 日期禁用状态 */
.date-item.disabled {
  pointer-events: none;
}

.date-number.is-disabled {
  color: #E0E0E0 !important;
  background: none !important;
}

.date-number.is-selected {
  background: #2E5A9B !important;
  color: #FFF !important;
  font-weight: 600;
}

/* 复用商品详情页的日历样式 */
.calendar-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #FFF;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: #FFF;
  border-bottom: 1px solid #F2F2F7;
}

/* 适配刘海屏和胶囊按钮 */
.renew-calendar-modal .calendar-header {
  padding-top: 56px !important; /* 固定56px，确保不被遮挡 */
}

.header-back {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 28px;
  color: #4A6FA5;
  font-weight: 300;
}

.header-title {
  font-size: 17px;
  font-weight: 600;
  color: #1D1D1F;
}

.header-placeholder {
  width: 40px;
}

.month-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: #FFF;
}

.month-prev, .month-next {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: #4A6FA5;
  font-weight: 300;
}

.month-display {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
}

.weekday-header {
  display: flex;
  padding: 12px 16px;
  background: #FFF;
}

.weekday-item {
  flex: 1;
  text-align: center;
  font-size: 13px;
  color: #8E8E93;
  font-weight: 500;
}

.calendar-grid {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  padding: 0 16px;
  background: #FFF;
  overflow-y: auto;
}

.date-item {
  width: 14.28%;
  height: 70px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.date-number {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  color: #1D1D1F;
  border-radius: 50%;
  position: relative;
  z-index: 1;
}

.date-number.is-today {
  color: #4A6FA5;
  border: 1px solid #4A6FA5;
}

.date-label {
  font-size: 10px;
  color: #4A6FA5;
  margin-top: 2px;
  font-weight: 500;
}

.today-label {
  color: #4A6FA5;
}

.calendar-footer {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  background: #FFF;
  border-top: 1px solid #F2F2F7;
}

.selected-info {
  flex: 1;
  margin-right: 16px;
}

.info-content {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row.highlight {
  margin-top: 4px;
}

.info-days-text {
  font-size: 16px;
  color: #4A6FA5;
  font-weight: 600;
}

.info-label {
  font-size: 13px;
  color: #8E8E93;
  margin-right: 8px;
}

.info-value {
  font-size: 14px;
  color: #1D1D1F;
  font-weight: 500;
}

.info-placeholder {
  font-size: 14px;
  color: #C7C7CC;
}

.action-buttons {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.reset-btn {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #E5E5E5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

.reset-btn.active {
  background: #FFF;
  border: 2px solid #4A6FA5;
  box-shadow: 0 4px 12px rgba(74, 111, 165, 0.2);
}

.reset-btn.active .btn-icon {
  color: #4A6FA5;
}

.confirm-btn {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #E5E5E5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn.active {
  background: linear-gradient(135deg, #4A6FA5 0%, #5A7A9B 100%);
  box-shadow: 0 4px 12px rgba(74, 111, 165, 0.3);
}

.btn-icon {
  font-size: 24px;
  color: #FFF;
  font-weight: bold;
}
