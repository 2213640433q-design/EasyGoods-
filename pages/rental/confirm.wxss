/* 全局盒模型修正 - 确保 padding 不会导致溢出 */
page, view, text, image {
  box-sizing: border-box;
}

page, .page { 
  min-height: 100vh; 
  background: #F8F9FA; 
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.topbar { 
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  padding: 10px 16px; 
  background: #FFF; 
  border-bottom: 1px solid #F2F2F7;
  z-index: 1000;
}

.nav-left, .nav-right { 
  width: 60px; 
}

.back-icon { 
  font-size: 28px; 
  color: #1D1D1F; 
}

.title { 
  flex: 1;
  text-align: center; 
  font-size: 16px; 
  font-weight: 600; 
  color: #1D1D1F; 
}

/* 内容区域 */
.content {
  position: fixed;
  top: calc(44px + env(safe-area-inset-top));
  left: 0;
  right: 0;
  bottom: 70px;  /* 底部栏高度 + 安全区域 */
  padding: 12px 16px 20px 16px;
  box-sizing: border-box;
  overflow-y: scroll;  /* 确保可以滚动 */
}

/* 门店信息 */
.store-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box; /* <-- 新增 */
}

.store-header {
  margin-bottom: 12px;
}

.store-name {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
}

.store-details {
  border-top: 1px solid #F2F2F7;
  padding-top: 12px;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8px;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  width: 80px;
  font-size: 14px;
  color: #8E8E93;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 14px;
  color: #1D1D1F;
  text-align: left;
}

.detail-value.phone {
  color: #4A6FA5;
}

/* 商品信息 */
.product-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
}

.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12px;
}

.product-card {
  display: flex;
  align-items: center;
}

.product-image {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  margin-right: 12px;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 14px;
  font-weight: 500;
  color: #1D1D1F;
  margin-bottom: 6px;
}

.product-subtitle {
  font-size: 12px;
  color: #8E8E93;
}

.accessories-info {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #F2F2F7;
  display: flex;
}

.accessories-label {
  font-size: 13px;
  color: #8E8E93;
  margin-right: 8px;
  flex-shrink: 0;
}

.accessories-text {
  flex: 1;
  font-size: 13px;
  color: #1D1D1F;
}

/* 租赁信息 */
.rental-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
}

/* 优惠券选择区 */
.coupon-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
}

.coupon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coupon-label {
  font-size: 14px;
  color: #1D1D1F;
  font-weight: 500;
}

.coupon-select {
  display: flex;
  align-items: center;
  gap: 6px;
}

.coupon-text {
  font-size: 13px;
  color: #4A6FA5;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-text-placeholder {
  font-size: 13px;
  color: #8E8E93;
}

.coupon-arrow {
  font-size: 16px;
  color: #C7C7CC;
}

.coupon-discount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #F2F2F7;
}

.discount-text {
  font-size: 12px;
  color: #FF3B30;
  font-weight: 500;
}

.cancel-coupon {
  font-size: 14px;
  color: #8E8E93;
  padding: 2px 6px;
}

.rental-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.rental-row:last-child {
  margin-bottom: 0;
}

.rental-label {
  font-size: 14px;
  color: #8E8E93;
}

.rental-value {
  font-size: 14px;
  color: #1D1D1F;
  text-align: left;
}

/* 费用明细 */
.price-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.price-row:last-child {
  margin-bottom: 0;
}

.price-label {
  font-size: 14px;
  color: #1D1D1F;
}

.price-value {
  font-size: 14px;
  color: #1D1D1F;
  text-align: right;
}

/* 小计行 */
.price-row.subtotal {
  padding-top: 8px;
  border-top: 1px solid #F2F2F7;
  margin-top: 8px;
}

.price-label-subtotal {
  font-size: 14px;
  color: #1D1D1F;
}

.price-value-subtotal {
  font-size: 14px;
  color: #1D1D1F;
  font-weight: 500;
}

/* 押金行（在费用明细中） */
.price-row.deposit-row {
  background: #FFF9E6;
  margin: 10px 0;
  padding: 10px;
  border-radius: 6px;
}

.deposit-label-with-note {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.deposit-note-inline {
  font-size: 11px;
  color: #8E8E93;
  margin-top: 2px;
}

/* 总计行 */
.price-row.total {
  padding-top: 10px;
  border-top: 1px solid #F2F2F7;
  margin-top: 10px;
}

.price-label-total {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F;
}

.price-value-total {
  font-size: 18px;
  font-weight: 600;
  color: #FF6B6B;
  text-align: right;
}

/* 押金信息（旧样式，已废弃但保留以防万一） */
.deposit-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
}

.deposit-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.deposit-label {
  font-size: 14px;
  color: #1D1D1F;
}

.deposit-value {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  text-align: right;
}

.deposit-note {
  font-size: 12px;
  color: #8E8E93;
}

/* 备注 */
.note-section {
  background: #FFF;
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 12px;
  box-sizing: border-box; /* <-- 新增 */
}

.note-title {
  font-size: 14px;
  color: #1D1D1F;
  margin-bottom: 10px;
}

.note-input {
  width: 100%;
  min-height: 80px;
  background: #F8F9FA;
  border-radius: 8px;
  padding: 10px;
  font-size: 14px;
  color: #1D1D1F;
  box-sizing: border-box; /* <-- 新增 */
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF;
  border-top: 1px solid #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  z-index: 1000;
}

.bottom-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
}

.pay-label {
  font-size: 12px;
  color: #8E8E93;
  margin-bottom: 2px;
}

.pay-amount-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
}

.pay-amount {
  font-size: 20px;
  font-weight: 600;
  color: #FF6B6B;
  line-height: 1.2;
}

.pay-detail {
  font-size: 10px;
  color: #8E8E93;
}

.submit-btn {
  background: #4A6FA5;
  color: #FFF;
  border-radius: 18px;
  padding: 10px 28px;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  background: #3D5D8C;
  transform: scale(0.98);
}

/* 按钮包装器 */
.btn-wrapper {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* 小取消按钮 */
.cancel-mini-btn {
  background: #FFF;
  color: #FF3B30;
  border: 1px solid #FF3B30;
  border-radius: 18px;
  padding: 9px 14px;
  font-size: 13px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-mini-btn:active {
  background: #FFF5F4;
  transform: scale(0.98);
}

.order-status-btn {
  background: #F2F2F7;
  color: #8E8E93;
  border-radius: 20px;
  padding: 12px 40px;
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 优惠券折扣行 */
.price-row.discount-row {
  color: #FF3B30;
}

.price-row.discount-row .price-value.discount {
  color: #FF3B30;
  font-weight: 600;
}

/* 优惠券选择弹窗 */
.coupon-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
}

.coupon-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF;
  border-radius: 16px 16px 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  z-index: 2001;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #F2F2F7;
}

.sheet-title {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
}

.sheet-close {
  font-size: 20px;
  color: #8E8E93;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-content {
  flex: 1;
  padding: 12px 16px;
  overflow-y: auto;
}

.sheet-coupon-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #F8FAFB 0%, #FFFFFF 100%);
  border: 1px solid #E5E5EA;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 10px;
}

.sheet-coupon-left {
  flex: 1;
  padding-right: 10px;
}

.sheet-coupon-name {
  font-size: 14px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 6px;
}

.sheet-coupon-desc {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #8E8E93;
}

.max-discount {
  color: #FF6B6B;
}

.sheet-coupon-right {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sheet-amount-wrapper {
  display: flex;
  align-items: baseline;
}

.sheet-amount-symbol {
  font-size: 12px;
  color: #FF3B30;
  margin-right: 2px;
}

.sheet-amount-value {
  font-size: 24px;
  font-weight: 700;
  color: #FF3B30;
}

.sheet-discount-label {
  font-size: 10px;
  color: #8E8E93;
  margin-top: 2px;
}

.sheet-coupon-item.no-coupon {
  justify-content: center;
  border-color: #C7C7CC;
  border-style: dashed;
  background: #FFF;
}

.no-coupon-text {
  font-size: 14px;
  color: #8E8E93;
}

/* 支付弹窗 */
.payment-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
}

.payment-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF;
  border-radius: 20px 20px 0 0;
  z-index: 2001;
  padding-bottom: env(safe-area-inset-bottom);
}

.payment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 20px 16px;
  border-bottom: 1px solid #F2F2F7;
}

.payment-title {
  font-size: 17px;
  font-weight: 600;
  color: #1D1D1F;
}

.payment-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: #8E8E93;
}

.payment-amount {
  padding: 20px;
  text-align: center;
}

.amount-label {
  display: block;
  font-size: 14px;
  color: #8E8E93;
  margin-bottom: 8px;
}

.amount-value {
  display: block;
  font-size: 32px;
  font-weight: 600;
  color: #FF6B6B;
}

.payment-methods {
  padding: 0 20px;
}

.payment-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background: #F8F9FA;
  border-radius: 12px;
  margin-bottom: 12px;
}

.payment-item.selected {
  background: #EEF3F8;
  border: 1px solid #4A6FA5;
}

.payment-item-left {
  display: flex;
  align-items: center;
}

.payment-icon {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-right: 12px;
}

.wechat-icon {
  background: #09BB07;
}

.cash-icon {
  background: #FFB800;
}

.payment-name {
  font-size: 15px;
  color: #1D1D1F;
  font-weight: 500;
}

.payment-radio {
  width: 20px;
  height: 20px;
  border: 2px solid #D1D1D6;
  border-radius: 10px;
}

.payment-radio.checked {
  border-color: #4A6FA5;
  background: #4A6FA5;
  position: relative;
}

.payment-radio.checked::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 8px;
  height: 8px;
  background: #FFF;
  border-radius: 4px;
}

.payment-footer {
  padding: 16px 20px 20px;
}

.payment-btn {
  background: #4A6FA5;
  color: #FFF;
  border-radius: 24px;
  padding: 14px 0;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
}

/* 🚫 取消订单弹窗样式 */
.cancel-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  animation: fadeIn 0.3s;
}

.cancel-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFF;
  border-radius: 20px 20px 0 0;
  z-index: 2001;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}

.cancel-sheet.show {
  transform: translateY(0);
}

.cancel-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 16px;
  border-bottom: 1px solid #F2F2F7;
}

.cancel-sheet-title {
  font-size: 17px;
  font-weight: 600;
  color: #1D1D1F;
}

.cancel-sheet-close {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #8E8E93;
  line-height: 1;
}

.cancel-sheet-content {
  flex: 1;
  overflow-y: auto;
  padding: 8px 0;
}

.cancel-reason-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  border-bottom: 1px solid #F8F9FA;
  transition: background 0.2s;
}

.cancel-reason-item:active {
  background: #F8F9FA;
}

.reason-text {
  font-size: 15px;
  color: #1D1D1F;
  flex: 1;
}

.reason-arrow {
  font-size: 20px;
  color: #C7C7CC;
  margin-left: 8px;
}

