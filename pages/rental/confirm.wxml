<view class="page">
  <!-- 顶部导航栏 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="title">确认订单</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view class="content" scroll-y>
    <!-- 门店信息 -->
    <view class="store-section">
      <view class="store-header">
        <text class="store-name">{{storeName}}</text>
      </view>
      <view class="store-details">
        <view class="detail-row">
          <text class="detail-label">取货地址</text>
          <text class="detail-value">{{storeAddress}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">邮编</text>
          <text class="detail-value">{{storePostcode}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">营业时间</text>
          <text class="detail-value">{{storeHours}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">联系电话</text>
          <text class="detail-value phone">{{storePhone}}</text>
        </view>
      </view>
    </view>

    <!-- 商品信息 -->
    <view class="product-section">
      <view class="section-title">租赁商品</view>
      <view class="product-card">
        <image class="product-image" src="{{productImage}}" mode="aspectFill"/>
        <view class="product-info">
          <text class="product-name">{{productName}}</text>
          <text class="product-subtitle">{{productSubtitle}}</text>
        </view>
      </view>
      
      <!-- 配件列表 -->
      <view class="accessories-info" wx:if="{{selectedAccessories.length > 0}}">
        <text class="accessories-label">配件：</text>
        <text class="accessories-text">{{accessoriesText}}</text>
      </view>
    </view>

    <!-- 租赁信息 -->
    <view class="rental-section">
      <view class="section-title">租赁信息</view>
      <view class="rental-row">
        <text class="rental-label">租赁时间</text>
        <text class="rental-value">{{rentalStartDate}} - {{rentalEndDate}}</text>
      </view>
      <view class="rental-row">
        <text class="rental-label">租赁天数</text>
        <text class="rental-value">{{rentalDays}}天</text>
      </view>
      <view class="rental-row">
        <text class="rental-label">取货地点</text>
        <text class="rental-value">{{pickupLocation}}</text>
      </view>
    </view>

    <!-- 优惠券选择 -->
    <view class="coupon-section" bindtap="openCouponSheet">
      <view class="coupon-row">
        <text class="coupon-label">优惠券</text>
        <view class="coupon-select">
          <text class="coupon-text" wx:if="{{selectedCoupon}}">{{selectedCoupon.couponName}}</text>
          <text class="coupon-text-placeholder" wx:else>{{availableCoupons.length > 0 ? '有' + availableCoupons.length + '张可用' : '暂无可用'}}</text>
          <text class="coupon-arrow">›</text>
        </view>
      </view>
      <view class="coupon-discount" wx:if="{{selectedCoupon}}">
        <text class="discount-text">已优惠 £{{couponDiscount}}</text>
        <text class="cancel-coupon" catchtap="onCancelCoupon">✕</text>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="price-section">
      <view class="section-title">费用明细</view>
      <view class="price-row">
        <text class="price-label">器材租金</text>
        <text class="price-value">£{{equipmentPrice}}</text>
      </view>
      <view class="price-row" wx:if="{{accessoriesPrice > 0}}">
        <text class="price-label">配件费用</text>
        <text class="price-value">£{{accessoriesPrice}}</text>
      </view>
      <view class="price-row discount-row" wx:if="{{selectedCoupon}}">
        <text class="price-label">优惠券</text>
        <text class="price-value discount">-£{{couponDiscount}}</text>
      </view>
      <view class="price-row subtotal">
        <text class="price-label-subtotal">小计</text>
        <text class="price-value-subtotal">£{{totalPrice - couponDiscount}}</text>
      </view>
      <view class="price-row deposit-row">
        <view class="deposit-label-with-note">
          <text class="price-label">器材押金</text>
          <text class="deposit-note-inline">（订单完成后退还）</text>
        </view>
        <text class="price-value">£{{deposit}}</text>
      </view>
      <view class="price-row total">
        <text class="price-label-total">订单总额</text>
        <text class="price-value-total">£{{totalAmount}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="note-section">
      <view class="note-title">备注</view>
      <textarea class="note-input" 
                placeholder="请输入备注" 
                value="{{note}}"
                bindinput="onNoteInput"
                maxlength="200"/>
    </view>
  </scroll-view>

  <!-- 底部提交栏 -->
  <view class="bottom-bar" style="padding-bottom: calc(env(safe-area-inset-bottom) / 2 + 2px);" wx:if="{{!isPaid}}">
    <view class="bottom-left">
      <text class="pay-label">待支付</text>
      <view class="pay-amount-row">
        <text class="pay-amount">£{{totalAmount}}</text>
        <text class="pay-detail">（租金£{{totalPrice - couponDiscount}}+押金£{{deposit}}）</text>
      </view>
    </view>
    
    <!-- 按钮区域 -->
    <view class="btn-wrapper">
      <!-- 重新支付：显示取消+提交 -->
      <view class="cancel-mini-btn" wx:if="{{orderId}}" bindtap="onCancelOrderFromConfirm">
        <text>取消</text>
      </view>
      <view class="submit-btn" bindtap="onSubmitOrder">
        <text>提交订单</text>
      </view>
    </view>
  </view>
  
  <!-- 已支付订单底部栏 -->
  <view class="bottom-bar" style="padding-bottom: calc(env(safe-area-inset-bottom) / 2 + 2px);" wx:if="{{isPaid}}">
    <view class="bottom-left">
      <text class="pay-label">订单总额</text>
      <text class="pay-amount">£{{totalAmount}}</text>
    </view>
    <view class="order-status-btn">
      <text>{{orderStatusText}}</text>
    </view>
  </view>

  <!-- 支付弹窗遮罩 -->
  <view class="payment-mask" wx:if="{{showPayment}}" bindtap="closePayment"></view>
  
  <!-- 支付弹窗 -->
  <view class="payment-modal" wx:if="{{showPayment}}">
    <view class="payment-header">
      <text class="payment-title">选择支付方式</text>
      <view class="payment-close" bindtap="closePayment">✕</view>
    </view>
    
    <view class="payment-amount">
      <text class="amount-label">支付金额</text>
      <text class="amount-value">£{{totalAmount}}</text>
    </view>
    
    <view class="payment-methods">
      <view class="payment-item {{selectedPayment === 'wechat' ? 'selected' : ''}}" 
            bindtap="selectPayment" 
            data-type="wechat">
        <view class="payment-item-left">
          <view class="payment-icon wechat-icon">
            <text>💬</text>
          </view>
          <text class="payment-name">微信支付</text>
        </view>
        <view class="payment-radio {{selectedPayment === 'wechat' ? 'checked' : ''}}"></view>
      </view>
      
      <view class="payment-item {{selectedPayment === 'cash' ? 'selected' : ''}}" 
            bindtap="selectPayment" 
            data-type="cash">
        <view class="payment-item-left">
          <view class="payment-icon cash-icon">
            <text>💷</text>
          </view>
          <text class="payment-name">线下支付</text>
        </view>
        <view class="payment-radio {{selectedPayment === 'cash' ? 'checked' : ''}}"></view>
      </view>
    </view>
    
    <view class="payment-footer">
      <view class="payment-btn" bindtap="confirmPayment">
        <text>确认支付</text>
      </view>
    </view>
  </view>

  <!-- 优惠券选择弹窗 -->
  <view class="coupon-sheet-mask" wx:if="{{showCouponSheet}}" bindtap="closeCouponSheet"></view>
  <view class="coupon-sheet" wx:if="{{showCouponSheet}}">
    <view class="sheet-header">
      <text class="sheet-title">选择优惠券</text>
      <view class="sheet-close" bindtap="closeCouponSheet">✕</view>
    </view>
    
    <scroll-view class="sheet-content" scroll-y>
      <view class="sheet-coupon-item" 
            wx:for="{{availableCoupons}}" 
            wx:key="_id"
            data-index="{{index}}"
            bindtap="onSelectCoupon">
        <view class="sheet-coupon-left">
          <view class="sheet-coupon-name">{{item.couponName}}</view>
          <view class="sheet-coupon-desc">
            <text>满£{{item.minAmount}}可用</text>
            <text wx:if="{{item.couponType === 'discount' && item.maxDiscount}}" class="max-discount">最高优惠£{{item.maxDiscount}}</text>
          </view>
        </view>
        <view class="sheet-coupon-right">
          <view class="sheet-amount-wrapper">
            <text class="sheet-amount-symbol">£</text>
            <text class="sheet-amount-value">{{item.discountAmount}}</text>
          </view>
          <text class="sheet-discount-label">可优惠</text>
        </view>
      </view>
      
      <!-- 不使用优惠券选项 -->
      <view class="sheet-coupon-item no-coupon" bindtap="closeCouponSheet">
        <text class="no-coupon-text">不使用优惠券</text>
      </view>
    </scroll-view>
  </view>

  <!-- 🚫 取消订单原因选择弹窗 -->
  <view class="cancel-sheet-mask" wx:if="{{showCancelReasonSheet}}" bindtap="closeCancelSheet"></view>
  <view class="cancel-sheet {{showCancelReasonSheet ? 'show' : ''}}">
    <view class="cancel-sheet-header">
      <text class="cancel-sheet-title">选择取消原因</text>
      <view class="cancel-sheet-close" bindtap="closeCancelSheet">
        <text>×</text>
      </view>
    </view>
    <view class="cancel-sheet-content">
      <view class="cancel-reason-item" 
            wx:for="{{cancelReasons}}" 
            wx:key="*this"
            data-reason="{{item}}"
            bindtap="onSelectCancelReason">
        <text class="reason-text">{{item}}</text>
        <text class="reason-arrow">›</text>
      </view>
    </view>
  </view>
  
  <!-- 支付成功弹窗 -->
  <custom-modal
    visible="{{showSuccessModal}}"
    title="{{successModalTitle}}"
    content="{{successModalContent}}"
    showCancel="{{false}}"
    confirmText="我知道了"
    confirmColor="#4A6FA5"
    bind:confirm="closeSuccessModal"
  />
</view>

