<!-- 顶部导航栏（固定） -->
<view class="navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-content" style="height: {{navBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">器材详情</view>
    <view class="nav-actions"></view>
  </view>
</view>

<!-- 可滚动内容区 -->
<scroll-view scroll-y class="rental-detail-scroll" enable-back-to-top>
  <!-- 顶部Logo -->
  <view class="top-logo">
    <text class="logo-text">🎬 兰拓科技 IRENTALS</text>
  </view>

  <!-- 商品图片轮播 -->
  <view class="product-images">
    <swiper class="swiper" indicator-dots="{{false}}" autoplay circular bindchange="onImageChange">
      <swiper-item wx:for="{{product.images}}" wx:key="index">
        <image class="product-main-image" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
    <view class="image-indicator">{{currentImageIndex + 1}}/{{product.images.length}}</view>
  </view>

  <!-- 提示信息（按钮风格） -->
  <view class="alert-button">机身颜色随机发货</view>

  <!-- 商品主要信息 -->
  <view class="product-main-info">
    <view class="product-title-section">
      <view class="product-title">{{product.name}}</view>
      <view class="product-subtitle">{{product.subtitle}}</view>
    </view>
    
    <view class="deposit-section">
      <view class="deposit-left">
        <text class="deposit-label">押金 ¥ {{product.deposit}}</text>
        <text class="deposit-note">不支持买断</text>
      </view>
      <text class="rental-count">已租{{product.rentedCount || 0}}</text>
    </view>
  </view>

  <!-- 租期选项卡片 -->
  <view class="rental-options-card">
    <view class="rental-option-item" 
          wx:for="{{rentalOptions}}" 
          wx:key="index"
          data-index="{{index}}"
          bindtap="onRentalOptionTap">
      <view class="option-price">
        <text class="price-number">£{{item.price}}</text>
        <text class="price-unit">/天</text>
      </view>
      <view class="option-label">租{{item.days}}天</view>
    </view>
  </view>

  <!-- 起租说明 -->
  <view class="info-section">
    <view class="info-row">
      <text class="info-label">起租</text>
      <text class="info-value">{{product.startRent}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">配件</text>
      <text class="info-value">{{product.accessories}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">说明</text>
      <text class="info-value">{{product.description}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">门店</text>
      <view class="stores-list">
        <text class="store-item" wx:for="{{product.stores}}" wx:key="index">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="detail-tabs">
    <view class="tab-item" 
          wx:for="{{['拍摄样片', '产品介绍']}}" 
          wx:key="index"
          data-index="{{index}}"
          bindtap="onTabChange">
      <text class="tab-text" style="{{currentTab === index ? 'color: #4A6FA5; font-weight: 600;' : ''}}">{{item}}</text>
      <view class="tab-underline" wx:if="{{currentTab === index}}"></view>
    </view>
  </view>

  <!-- Tab内容区 -->
  <view class="tab-content">
    <!-- 拍摄样片 -->
    <view wx:if="{{currentTab === 0}}" class="tab-panel">
      <view class="sample-images-grid">
        <image wx:for="{{product.sampleImages}}" wx:key="index" 
               class="sample-image" 
               src="{{item}}" 
               mode="aspectFill"></image>
      </view>
    </view>

    <!-- 产品介绍 -->
    <view wx:if="{{currentTab === 1}}" class="tab-panel">
      <!-- 温馨提示卡片 -->
      <view class="warning-card">
        <view class="warning-icon">⚠️</view>
        <view class="warning-content">
          <view class="warning-title">温馨提示：</view>
          <view class="warning-text">{{product.description}}</view>
        </view>
      </view>

      <!-- 产品对比图（只在有对比图时显示） -->
      <view class="comparison-section" wx:if="{{product.comparisonImages && product.comparisonImages.length > 0}}">
        <view class="section-title">产品对比</view>
        <image wx:for="{{product.comparisonImages}}" wx:key="index" 
               class="comparison-image" 
               src="{{item}}" 
               mode="widthFix"></image>
      </view>

      <!-- 产品参数 -->
      <view class="specs-section">
        <view class="spec-row" wx:for="{{product.specs}}" wx:key="label">
          <text class="spec-label">{{item.label}}</text>
          <text class="spec-value">{{item.value}}</text>
        </view>
      </view>

      <!-- 商品宣传图（只在有宣传图时显示） -->
      <view class="promo-image-section" wx:if="{{product.promoImage}}">
        <image class="promo-image" 
               src="{{product.promoImage}}" 
               mode="widthFix"></image>
      </view>
    </view>

    <!-- 评论区已暂时隐藏，待评论系统开发后启用 -->
  </view>

  <!-- 底部占位，防止内容被底部栏遮挡 -->
  <view class="bottom-placeholder"></view>
</scroll-view>

<!-- 底部操作栏（固定） -->
<view class="bottom-bar" style="padding-bottom: calc(env(safe-area-inset-bottom) / 2 + 2px);">
  <view class="bar-left">
    <view class="service-btn" bindtap="onToggleCollect">
      <image class="service-icon-img" src="{{collected ? '/static/icons/favorite-on.png' : '/static/icons/favorite-off.png'}}" mode="aspectFit"/>
      <text class="service-text">收藏</text>
    </view>
  </view>
  <view class="bar-right">
    <view class="btn-primary" bindtap="onRentNow">立即租赁</view>
  </view>
</view>

<!-- 租赁滑窗 -->
<view class="rental-sheet-mask" wx:if="{{showRentalSheet}}" bindtap="closeRentalSheet"></view>
<view class="rental-sheet" style="{{showRentalSheet ? 'transform: translateY(0);' : 'transform: translateY(100%);'}}">
  <view class="sheet-header">
    <text class="sheet-title">租赁信息</text>
    <view class="sheet-close" bindtap="closeRentalSheet">✕</view>
  </view>
  
  <view class="sheet-content">
    <!-- 取货地点 -->
    <view class="sheet-item-compact">
      <picker mode="selector" range="{{pickupLocations}}" value="{{selectedPickupIndex}}" bindchange="onPickupLocationChange">
        <view class="compact-row">
          <text class="compact-label">取货地点</text>
          <view class="compact-value">
            <text class="compact-text">{{pickupLocations[selectedPickupIndex]}}</text>
            <text class="compact-arrow">›</text>
          </view>
        </view>
      </picker>
    </view>
    
    <!-- 租赁时间段 - 点击打开日历 -->
    <view class="sheet-item-compact" bindtap="openCalendar">
      <view class="compact-row">
        <text class="compact-label">租赁时间</text>
        <view class="compact-value">
          <view wx:if="{{rentalStartDate && rentalEndDate}}" class="compact-date-result">
            <text class="compact-text">{{rentalStartDate}} - {{rentalEndDate}}</text>
            <text class="compact-days">共{{rentalDays}}天</text>
          </view>
          <text wx:else class="compact-placeholder">请选择器材租期</text>
          <text class="compact-arrow">›</text>
        </view>
      </view>
    </view>
    
    <!-- 付费配件 -->
    <view class="sheet-item accessories-section">
      <view class="item-label">付费配件（可选）</view>
      <view class="accessories-list">
        <view class="accessory-item" 
              wx:for="{{extraAccessories}}" 
              wx:key="id"
              data-index="{{index}}"
              bindtap="onAccessoryToggle">
          <view class="accessory-info">
            <text class="accessory-name">{{item.name}}</text>
            <text class="accessory-price">£{{item.price}}/天</text>
          </view>
          <view class="accessory-checkbox" style="{{item.selected ? 'background: #4A6FA5; border-color: #4A6FA5;' : ''}}">
            <text class="checkbox-icon" wx:if="{{item.selected}}">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 底部价格和按钮 -->
  <view class="sheet-footer">
    <view class="footer-price">
      <text class="price-label">总价：</text>
      <text class="price-value">£{{totalPrice}}</text>
    </view>
    <view class="footer-btn" bindtap="onNextStep">下一步</view>
  </view>
</view>

<!-- 全屏日历选择器 -->
<view class="calendar-modal" wx:if="{{showCalendar}}">
  <view class="calendar-container">
    <!-- 日历头部 -->
    <view class="calendar-header">
      <view class="header-back" bindtap="closeCalendar">
        <text class="back-icon">‹</text>
      </view>
      <view class="header-title">选择租期</view>
      <view class="header-placeholder"></view>
    </view>
    
    <!-- 月份切换 -->
    <view class="month-switcher">
      <view class="month-prev" bindtap="prevMonth">‹</view>
      <view class="month-display">{{currentYear}}年{{currentMonth}}月</view>
      <view class="month-next" bindtap="nextMonth">›</view>
    </view>
    
    <!-- 星期标题 -->
    <view class="weekday-header">
      <view class="weekday-item" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="index">{{item}}</view>
    </view>
    
    <!-- 日历日期网格 -->
    <view class="calendar-grid">
      <view class="date-item"
            wx:for="{{calendarDates}}"
            wx:key="index"
            data-date="{{item.date}}"
            bindtap="onDateTap"
            style="{{item.isOtherMonth ? 'opacity: 0.3;' : ''}}">
        <view class="date-number {{item.isToday ? 'is-today' : ''}} {{item.isStart ? 'is-start' : ''}} {{item.isEnd ? 'is-end' : ''}} {{item.isInRange ? 'is-in-range' : ''}} {{item.isPast ? 'is-past' : ''}}">
          {{item.day}}
        </view>
        <view wx:if="{{item.isStart}}" class="date-label">自取</view>
        <view wx:if="{{item.isEnd}}" class="date-label">归还</view>
        <view wx:if="{{item.isToday && !item.isStart && !item.isEnd}}" class="date-label today-label">今天</view>
      </view>
    </view>
    
    <!-- 底部操作栏 -->
    <view class="calendar-footer">
      <view class="selected-info">
        <view wx:if="{{calendarStartDate && calendarEndDate}}" class="info-content">
          <view class="info-row">
            <text class="info-label">自取器材</text>
            <text class="info-value">{{calendarStartDate}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">归还器材</text>
            <text class="info-value">{{calendarEndDate}}</text>
          </view>
          <view class="info-row highlight">
            <text class="info-days-text">共{{calendarDays}}天</text>
          </view>
        </view>
        <view wx:else class="info-placeholder">
          请选择租赁时间段
        </view>
      </view>
      <view class="action-buttons">
        <view class="reset-btn {{calendarStartDate || calendarEndDate ? 'active' : ''}}" bindtap="resetCalendar">
          <text class="btn-icon">↻</text>
        </view>
        <view class="confirm-btn {{calendarStartDate && calendarEndDate ? 'active' : ''}}" bindtap="confirmCalendar">
          <text class="btn-icon">✓</text>
        </view>
      </view>
    </view>
  </view>
</view>

