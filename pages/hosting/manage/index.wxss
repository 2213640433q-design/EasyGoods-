/* 托管管理中心样式 */
page {
  height: 100vh;
  background: #F5F5F7;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #FFF;
  z-index: 9999;
  border-bottom: 1px solid #E5E5EA;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 16px;
}

.nav-back, .nav-placeholder {
  width: 60px;
}

.nav-back {
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 28px;
  color: #1D1D1F;
  font-weight: 500;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #1D1D1F;
}

/* 滚动内容 */
.content {
  flex: 1;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #4A6FA5 0%, #5B7DB8 100%);
  margin: 12px;
  padding: 24px 16px;
  border-radius: 16px;
  box-shadow: 0 4px 12px rgba(74, 111, 165, 0.3);
}

.stats-title {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16px;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: #FFF;
}

.stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
}

/* Tab 切换 */
.tabs {
  display: flex;
  background: #FFF;
  margin: 0 12px 12px;
  border-radius: 12px;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 14px;
  color: #8E8E93;
  position: relative;
}

.tab-item.active {
  color: #4A6FA5;
  font-weight: 600;
  background: #E8F4FF;
}

.badge {
  position: absolute;
  top: 8px;
  right: 12px;
  background: #FF3B30;
  color: #FFF;
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 10px;
  min-width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 设备列表 */
.device-list {
  padding: 0 12px;
}

.loading, .empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 0;
}

.loading text {
  color: #8E8E93;
  font-size: 14px;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 14px;
  color: #8E8E93;
  margin-bottom: 24px;
}

.btn-add-device {
  background: #4A6FA5;
  color: #FFF;
  padding: 12px 32px;
  border-radius: 24px;
  font-size: 15px;
  border: none;
}

/* 设备卡片 */
.device-card {
  background: #FFF;
  border-radius: 12px;
  margin-bottom: 12px;
  overflow: hidden;
  display: flex;
}

.device-image {
  width: 100px;
  height: 100px;
  flex-shrink: 0;
  background: #F5F5F7;
}

.device-image image {
  width: 100%;
  height: 100%;
}

.device-info {
  flex: 1;
  padding: 12px;
  display: flex;
  flex-direction: column;
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.device-name {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 11px;
  margin-left: 8px;
}

.status-badge.pending {
  background: #FFF9E6;
  color: #FF9500;
}

.status-badge.online {
  background: #E6F7ED;
  color: #34C759;
}

.status-badge.rejected {
  background: #FFE6E6;
  color: #FF3B30;
}

.status-badge.recalled {
  background: #F0F0F0;
  color: #8E8E93;
}

.device-meta {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: #8E8E93;
  margin-bottom: 8px;
}

.meta-item {
  margin: 0 4px;
}

.separator {
  color: #C7C7CC;
}

.device-status {
  margin-bottom: 12px;
}

.status-text {
  font-size: 12px;
  color: #8E8E93;
}

.revenue-info {
  display: flex;
  align-items: center;
  font-size: 12px;
}

.revenue-label {
  color: #8E8E93;
  margin-right: 4px;
}

.revenue-value {
  font-size: 16px;
  font-weight: 700;
  color: #34C759;
  margin-right: 8px;
}

.reject-reason {
  font-size: 12px;
  color: #FF3B30;
  line-height: 1.5;
}

.device-actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
}

.action-btn {
  flex: 1;
  height: 32px;
  line-height: 32px;
  padding: 0;
  background: #F5F5F7;
  color: #4A6FA5;
  font-size: 13px;
  border-radius: 6px;
  border: none;
}

.action-btn.danger {
  background: #FFE6E6;
  color: #FF3B30;
}

/* 浮动添加按钮 */
.fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(env(safe-area-inset-bottom) + 20px);
  width: 56px;
  height: 56px;
  background: #4A6FA5;
  border-radius: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(74, 111, 165, 0.4);
  z-index: 9997;
}

.fab-icon {
  font-size: 32px;
  color: #FFF;
  font-weight: 300;
}

.bottom-placeholder {
  height: 20px;
}

