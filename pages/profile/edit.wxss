page, .page { 
  min-height: 100vh; 
  height: 100vh;
  background: #F8F9FA; 
  display: flex;
  flex-direction: column;
}

.topbar {
  position: relative;
  background: #FFF;
  border-bottom: 1px solid #F2F2F7;
  z-index: 1100;
  box-sizing: border-box;
  flex-shrink: 0;
}

.topbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  /* height 由内联样式动态设置 */
}

.nav-left, .nav-right {
  width: 60px;
  display: flex;
  align-items: center;
}

.nav-left {
  justify-content: flex-start;
}

.nav-right {
  justify-content: flex-end;
}

.back-icon {
  font-size: 24px;
  color: #1D1D1F;
  font-weight: 300;
}

.title {
  flex: 1;
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  text-align: center;
}

/* 滚动内容区 */
.scroll-content {
  flex: 1;
  height: 100%;
  width: 100%;
}

/* 分组标题 */
.section-header {
  padding: 20px 16px 8px;
  background: #F8F9FA;
}

.section-title {
  font-size: 13px;
  color: #8E8E93;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.form-container {
  background: #FFF;
  margin-bottom: 12px;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #F2F2F7;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 16px;
  color: #1D1D1F;
  font-weight: 400;
}

.value-container {
  display: flex;
  align-items: center;
  gap: 8px;
}

.value {
  font-size: 16px;
  color: #8E8E93;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 16px;
  color: #C7C7CC;
  font-weight: 300;
  flex-shrink: 0;
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 20px;
}

/* 退出登录按钮容器 */
.logout-container {
  padding: 24px 16px;
  background: #F8F9FA;
}

.logout-btn {
  width: 100%;
  height: 50px;
  background: #FFF;
  color: #FF3B30;
  font-size: 16px;
  font-weight: 600;
  border-radius: 25px;
  border: 1px solid #FF3B30;
  box-shadow: none;
  transition: all 0.3s ease;
}

.logout-btn:active {
  opacity: 0.6;
  background: #FFF1F0;
}

/* 底部占位 */
.bottom-placeholder {
  height: 20px;
  flex-shrink: 0;
}
