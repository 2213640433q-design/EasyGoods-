<view class="page">
  <!-- 顶部导航栏 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="topbar-content" style="height: {{navBarHeight}}px;">
      <view class="nav-left" bindtap="goBack">
        <text class="back-icon">‹</text>
      </view>
      <text class="title">个人资料</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <scroll-view scroll-y class="scroll-content" enable-back-to-top>
    <!-- 头像卡片 -->
    <view class="avatar-card">
      <view class="avatar-container" bindtap="editAvatar">
        <image class="main-avatar" src="{{userInfo.avatar || '/static/icons/logo.png'}}" mode="aspectFill"/>
        <view class="avatar-edit-badge">
          <text class="edit-icon">✏️</text>
        </view>
      </view>
    </view>

    <!-- 基本信息卡片 -->
    <view class="info-card">
      <!-- 用户名 -->
      <view class="form-item" bindtap="editNickname">
        <text class="label">用户名</text>
        <view class="value-container">
          <text class="value {{!userInfo.nickname ? 'placeholder' : ''}}">{{userInfo.nickname || '请输入您的姓名'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <!-- 性别 -->
      <view class="form-item gender-item">
        <text class="label">性别</text>
        <view class="gender-buttons">
          <view class="gender-btn {{userInfo.gender === '男' ? 'active' : ''}}" bindtap="onGenderSelect" data-gender="男">
            <text class="gender-text">男</text>
          </view>
          <view class="gender-btn {{userInfo.gender === '女' ? 'active' : ''}}" bindtap="onGenderSelect" data-gender="女">
            <text class="gender-text">女</text>
          </view>
        </view>
      </view>

      <!-- 生日 -->
      <view class="form-item" bindtap="editBirthday">
        <text class="label">生日</text>
        <view class="value-container">
          <text class="value">{{userInfo.birthday || '未设置'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 学校信息卡片 -->
    <view class="info-card">
      <!-- 院校名称 -->
      <view class="form-item" bindtap="editSchool">
        <text class="label">院校名称</text>
        <view class="value-container">
          <text class="value">{{userInfo.school || '未设置'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <!-- 城市 -->
      <view class="form-item" bindtap="editCity">
        <text class="label">城市</text>
        <view class="value-container">
          <text class="value">{{userInfo.city || '未设置'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <!-- 邮编 -->
      <view class="form-item" bindtap="editPostcode">
        <text class="label">邮编</text>
        <view class="value-container">
          <text class="value">{{userInfo.postcode || '未设置'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 联系方式卡片 -->
    <view class="info-card">
      <!-- 手机号 -->
      <view class="form-item">
        <text class="label">手机号</text>
        <view class="value-container">
          <text class="value phone-number">{{maskedPhone}}</text>
        </view>
      </view>
    </view>

    <!-- 退出登录按钮 -->
    <view class="logout-container">
      <button class="logout-btn" bindtap="onLogout">
        退出登录
      </button>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-placeholder"></view>
  </scroll-view>
</view>
