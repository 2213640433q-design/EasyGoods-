/* 子分类tab - 横向滑动 */
.sub-tabs-section {
  background: #FFF;
  border-bottom: 1px solid #F2F2F7;
  padding: 0 16px;
}

.sub-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

/* 隐藏滚动条 */
.sub-tabs-scroll::-webkit-scrollbar {
  display: none;
}

.sub-tabs-wrapper {
  display: inline-flex;
  align-items: center;
}

.sub-tab {
  position: relative;
  display: inline-block;
  padding: 10px 16px;
  margin-right: 8px;
}

.sub-tab-text {
  font-size: 14px;
  color: #8E8E93;
  font-weight: 400;
  white-space: nowrap;
}

.sub-tab.active .sub-tab-text {
  color: #1D1D1F;
  font-weight: 600;
}

.sub-tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  background: #4A6FA5;
  border-radius: 2px;
}

/* 商品网格样式 */
.products-section {
  padding: 6px 16px;
  padding-bottom: calc(110px + env(safe-area-inset-bottom));  /* 动态底部间距，适配安全区域 */
}

.products-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6px;
  align-items: flex-start;  /* 顶部对齐，允许不同高度 */
}

.product-item {
  width: 50%;
  box-sizing: border-box;
  padding: 0 0px 12px;
  background-color: #FFFFFF;
  border: 4px solid #F2F2F7;
  border-radius: 8px;
  box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.product-image-container {
  position: relative;
  width: 100%;
  height: 180px;  /* 从141px增加到180px，更高的视觉效果 */
}

.product-image { 
  width: 100%; 
  height: 100%; 
  object-fit: cover;  /* 确保图片填满容器且不变形 */
}

.product-info {
  padding: 10px 10px 4px 10px;  /* ✅ 底部6px，其他10px */
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 14px;
  color: #1D1D1F;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;           /* 使用弹性盒子布局 */
  -webkit-box-orient: vertical;   /* 垂直方向 */
  -webkit-line-clamp: 2;          /* 最多显示2行 */
  word-break: break-word;         /* 允许单词内换行 */
  margin-bottom: 4px;             /* 与下方标签的间距 */
}

.product-tags {
  display: flex;
  margin: 4px 0px 4px 0px;
}

.tag-main-category {
  font-size: 11px;
  color: #4A6FA5;
  background: #E8F4FF;
  padding: 2px 8px;
  border-radius: 4px;
  margin-right: 6px;
  font-weight: 500;
}

.tag-sub-category {
  font-size: 11px;
  color: #8E8E93;
  background: #F3F4F6;
  padding: 2px 8px;
  border-radius: 4px;
  margin-right: 6px;
}

.product-price {
  display: flex;
  align-items: baseline;
  line-height: 1.43;
}

.price-symbol {
  font-size: 12px;
  font-weight: 500;
  color: #FF8A80;
  margin-right: 1px;
}

.price-number {
  font-size: 17px;
  font-weight: 600;
  color: #FF6B6B;
}

.price-unit {
  font-size: 12px;
  font-weight: 400;
  color: #C7C7CC;
  margin-left: 2px;
}

/* 底部导航栏样式 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-top: 1px solid #F3F4F6;
  display: flex;
  align-items: center;
  padding: 2px 4px;
  padding-bottom: calc(env(safe-area-inset-bottom) / 2 + 2px);
  z-index: 1000;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-icon-img { 
  width: 24px; 
  height: 24px; 
  margin-bottom: 4px; 
  display: block;
  object-fit: contain;      /* ✅ 确保图片按比例缩放在24x24内 */
}

.nav-text {
  font-size: 12px;
  font-weight: 400;
  color: #8E8E93;
  line-height: 1.33;
}

.nav-item.active .nav-text {
  color: #4A6FA5;
}


