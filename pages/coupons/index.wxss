page { 
  min-height: 100vh; 
  background: #F8F9FA; 
}

.page { 
  min-height: 100vh; 
  background: #F8F9FA; 
}

/* 顶部导航栏 */
.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #FFF;
  border-bottom: 1px solid #F2F2F7;
  z-index: 1100;
  box-sizing: border-box;
}

.topbar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  height: 44px;
}

.nav-left, .nav-right {
  width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back {
  font-size: 28px;
  color: #1D1D1F;
  line-height: 1;
  font-weight: 300;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
}

/* Tab切换栏 */
.tabs-section {
  position: fixed;
  left: 0;
  right: 0;
  background: #FFF;
  border-bottom: 1px solid #F2F2F7;
  display: flex;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 48px;
  position: relative;
}

.tab-text {
  font-size: 15px;
  color: #8E8E93;
  font-weight: 500;
  transition: color 0.3s;
}

.tab-item.active .tab-text {
  color: #4A6FA5;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  background: #4A6FA5;
  border-radius: 1.5px;
}

/* 内容区域 */
.content {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow-y: auto;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100px 20px;
  text-align: center;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
  opacity: 0.5;
}

.empty-text {
  font-size: 16px;
  color: #8E8E93;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 14px;
  color: #C7C7CC;
}

/* 优惠券列表 */
.coupon-list {
  padding: 10px 12px;
  padding-bottom: 20px;
}

/* 优惠券卡片 */
.coupon-card {
  display: flex;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8FAFB 100%);
  border-radius: 8px;
  padding: 12px 14px;
  margin-bottom: 10px;
  box-shadow: 0 1px 4px rgba(74, 111, 165, 0.08);
  border: 1px solid #F2F2F7;
  position: relative;
  overflow: hidden;
}

/* 左侧信息区 */
.coupon-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 10px;
  min-width: 0;
}

.coupon-name {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.4;
  margin-bottom: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.coupon-bottom-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.coupon-expiry {
  font-size: 11px;
  color: #8E8E93;
}

.coupon-rules {
  font-size: 11px;
  color: #4D4D4D;
  display: inline-block;
  font-weight: 500;
}

/* 右侧金额和按钮区 */
.coupon-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 10px;
  border-left: 1px dashed #D1D5DB;
  min-width: 85px;
}

.coupon-amount-wrapper {
  display: flex;
  align-items: baseline;
  margin-bottom: 2px;
}

.amount-symbol {
  font-size: 14px;
  color: #FF3B30;
  font-weight: 600;
  margin-right: 1px;
}

.amount-value {
  font-size: 28px;
  color: #FF3B30;
  font-weight: 700;
  line-height: 1;
}

.coupon-threshold {
  font-size: 10px;
  color: #8E8E93;
  margin-bottom: 6px;
}

.use-btn {
  background: linear-gradient(135deg, #5A7A9B 0%, #4A6FA5 100%);
  color: #FFF;
  font-size: 12px;
  font-weight: 500;
  padding: 5px 16px;
  border-radius: 14px;
  box-shadow: 0 2px 6px rgba(74, 111, 165, 0.25);
}

/* 状态标签（已使用/已过期） */
.status-badge {
  background: #E5E5EA;
  color: #8E8E93;
  font-size: 11px;
  font-weight: 500;
  padding: 4px 12px;
  border-radius: 12px;
}

/* 已使用/已过期优惠券样式 */
.coupon-card.disabled {
  opacity: 0.5;
  filter: grayscale(0.8);
}

/* 已领取优惠券样式 */
.coupon-card.received {
  opacity: 0.5;
  filter: grayscale(0.8);
}

/* 库存信息 */
.coupon-stock {
  font-size: 10px;
  color: #FF6B6B;
  margin-top: 4px;
}

/* 领取按钮 */
.receive-btn {
  background: linear-gradient(135deg, #5A7A9B 0%, #4A6FA5 100%);
  color: #FFF;
  font-size: 12px;
  font-weight: 500;
  padding: 5px 16px;
  border-radius: 14px;
  box-shadow: 0 2px 6px rgba(74, 111, 165, 0.25);
}

/* 已领取标签 */
.received-badge {
  background: #E5E5EA;
  color: #8E8E93;
  font-size: 11px;
  font-weight: 500;
  padding: 4px 12px;
  border-radius: 12px;
}

/* 已抢光标签 */
.soldout-badge {
  background: #FFE5E5;
  color: #FF6B6B;
  font-size: 11px;
  font-weight: 500;
  padding: 4px 12px;
  border-radius: 12px;
}

/* 水印 */
.watermark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-20deg);
  font-size: 48px;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.05);
  pointer-events: none;
  white-space: nowrap;
  z-index: 1;
}

/* 底部提示 */
.footer-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px 16px;
  gap: 12px;
}

.tip-line {
  flex: 1;
  height: 1px;
  background: #E5E7EB;
  max-width: 80px;
}

.tip-text {
  font-size: 12px;
  color: #9CA3AF;
  white-space: nowrap;
}

/* 规则弹窗 */
.rules-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.rules-content {
  background: #FFF;
  border-radius: 16px;
  width: 100%;
  max-width: 320px;
  overflow: hidden;
}

.rules-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #F2F2F7;
}

.rules-title {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
}

.rules-close {
  font-size: 20px;
  color: #8E8E93;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rules-body {
  padding: 20px;
  max-height: 400px;
  overflow-y: auto;
}

.rules-text {
  font-size: 14px;
  color: #4D4D4D;
  line-height: 1.6;
  white-space: pre-wrap;
}

.rules-footer {
  padding: 12px 20px 16px;
}

.rules-btn {
  background: #4A6FA5;
  color: #FFF;
  text-align: center;
  padding: 12px;
  border-radius: 24px;
  font-size: 15px;
  font-weight: 500;
}

