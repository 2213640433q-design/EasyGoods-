page, .page { min-height: 100vh; background:#F8F9FA; }
.topbar { position: fixed; left:0; right:0; background:#FFF; border-bottom:1px solid #F2F2F7; display:flex; align-items:center; justify-content:space-between; height:44px; padding:0 12px; box-sizing:border-box; z-index:1000; }
.nav-left { width:60px; }
.nav-right { width:120px; display:flex; justify-content:flex-end; align-items:center; gap:12px; }
.back { font-size:24px; color:#1D1D1F; }
.title { flex:1; text-align:center; font-size:16px; font-weight:600; color:#1D1D1F; }
.icon { width:24px; height:24px; }
.manage { font-size:16px; line-height:1; padding:4px 0; color:#1D1D1F; }

.filters { 
  display: flex; 
  gap: 10px; 
  padding: 12px 16px; 
  background: #FFF; 
  border-bottom: 1px solid #F2F2F7; 
  align-items: center; 
}

.filter { 
  padding: 6px 16px; 
  background: #F1F3F5; 
  border-radius: 6px; 
  font-size: 13px; 
  color: #1D1D1F;
  transition: all 0.3s ease;
}

.filter.active { 
  background: #4A6FA5; 
  color: #FFF; 
  font-weight: 500;
}

.filters-spacer { flex: 1; }

.manage-btn { 
  font-size: 14px; 
  color: #4A6FA5;
  font-weight: 500;
}

.list { padding:12px; }
.item { position:relative; display:flex; align-items:flex-start; background:#FFF; border-radius:10px; padding:10px; margin-bottom:10px; }
.chk-wrap { width:28px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-right:8px; }
.chk { transform: scale(0.9); }
.thumb { width:72px; height:72px; border-radius:6px; margin-right:10px; flex-shrink:0; }
.thumb-wrap { position: relative; margin-right:10px; }
.meta { flex:1; min-width:0; }
.title1 { font-size:14px; color:#1D1D1F; line-height:1.4; margin-bottom:4px; display:block; }
.rented-count {
  font-size: 11px;
  color: #8E8E93;
  display: block;
  margin-bottom: 4px;
}
.price-row { display:flex; align-items:baseline; gap:2px; margin-bottom:4px; }
.currency { font-size:12px; color:#FF3B30; }
.price { font-size:16px; color:#FF3B30; font-weight:600; }
.unit { font-size:12px; color:#8E8E93; }
.fav-icon-img { position:absolute; right:10px; bottom:10px; width:18px; height:18px; }
.badge { position:absolute; left:4px; top:4px; background:#000; color:#FFF; font-size:10px; padding:2px 6px; border-radius:10px; opacity:.9; z-index:2; }
.sold { background:#6B7280; }

.manage-bar { position: fixed; left:0; right:0; bottom:0; background:#FFF; border-top:1px solid #F2F2F7; display:flex; align-items:center; gap:8px; padding:8px 12px; z-index:1000; }
.chk-all { margin-right:4px; }
.all-text { font-size:14px; color:#1D1D1F; margin-right:auto; }
.delete-btn { background:#EF4444; color:#FFF; border-radius:18px; padding:8px 18px; font-weight:600; }

