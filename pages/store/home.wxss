/* pages/store/home.wxss */
.page {
  height: 100vh;
  background: #F5F5F7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部导航栏 */
.topbar {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  position: relative;
  z-index: 100;
}

.nav-left, .nav-right {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 32px;
  color: #FFFFFF;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.5px;
}

/* 底部中间悬浮扫码按钮 */
.floating-scan-btn {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);  /* 水平居中 */
  bottom: 20px;  /* 距离底部20px */
  width: 64px;
  height: 64px;
  border-radius: 50%;  /* 圆形 */
  background: #FFFFFF;  /* 白色背景 */
  border: 2px solid #667EEA;  /* 蓝紫色边框 */
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  transition: all 0.3s ease;
}

.floating-scan-btn:active {
  transform: translateX(-50%) scale(0.92);  /* 保持居中同时缩小 */
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.scan-icon-img {
  width: 32px;
  height: 32px;
  display: block;
}

/* 筛选滚动容器 */
.filter-scroll {
  background: #FFFFFF;
  border-bottom: 1px solid #E5E5EA;
  white-space: nowrap;
  width: 100%;
  height: 48px;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
  z-index: 10;
}

/* 筛选栏内容 */
.filter-bar {
  padding: 12px 16px;
  display: inline-flex;
  flex-direction: row;
  white-space: nowrap;
  box-sizing: border-box;
  height: 100%;
  align-items: center;
}

.filter-item {
  flex-shrink: 0;
  padding: 6px 16px;
  border-radius: 16px;
  background: #F5F5F7;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-right: 12px; /* 筛选项之间的间距 */
  transition: all 0.2s;
  white-space: nowrap; /* 禁止内部换行 */
  cursor: pointer; /* 鼠标指针 */
}

.filter-item:last-child {
  margin-right: 16px; /* 最后一个加右边距，滚动时完全显示 */
}

.filter-item.active {
  background: #667EEA;
}

.filter-text {
  font-size: 14px;
  color: #1D1D1F;
  white-space: nowrap; /* 文字不换行 */
}

.filter-item.active .filter-text {
  color: #FFFFFF;
  font-weight: 500;
}

.filter-count {
  font-size: 12px;
  color: #86868B;
  background: #FFFFFF;
  border-radius: 10px;
  padding: 2px 6px;
  min-width: 18px;
  text-align: center;
  white-space: nowrap; /* 数字不换行 */
}

.filter-item.active .filter-count {
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}

/* 内容区域 */
.content {
  flex: 1;
  padding: 12px 16px;
  box-sizing: border-box;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.order-item {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.order-item:active {
  transform: scale(0.98);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #F5F5F7;
}

.order-id-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1; /* 占据剩余空间 */
  min-width: 0; /* 允许flex收缩 */
}

.order-id {
  font-size: 13px;
  color: #86868B;
  font-family: 'Courier New', monospace;
  white-space: nowrap; /* 订单号不换行 */
  flex-shrink: 0; /* 不压缩 */
}

.order-status {
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 500;
  white-space: nowrap; /* 状态文字不换行 */
  flex-shrink: 0; /* 不压缩 */
}

.order-status.pending {
  background: #FFF3E0;
  color: #F57C00;
}

.order-status.paid {
  background: #E3F2FD;
  color: #2E5A9B;
}

.order-status.picked {
  background: #E8F5E9;
  color: #388E3C;
}

.order-status.checking {
  background: #FFF9C4;
  color: #F57F17;
}

.order-status.completed {
  background: #E8F5E9;
  color: #388E3C;
}

.order-status.damaged {
  background: #FFEBEE;
  color: #FF3B30;
}

.order-time {
  font-size: 12px;
  color: #C7C7CC;
}

/* 商品信息 */
.order-product {
  display: flex;
  gap: 12px;
}

.product-img {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  background: #F5F5F7;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.product-name {
  font-size: 15px;
  font-weight: 500;
  color: #1D1D1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; /* 商品名称不换行 */
}

.product-detail {
  font-size: 12px;
  color: #86868B;
  white-space: nowrap; /* 详情文字不换行 */
}

.order-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
}

.amount-label {
  font-size: 11px;
  color: #86868B;
  margin-bottom: 2px;
}

.amount-value {
  font-size: 17px;
  font-weight: 600;
  color: #2E5A9B;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 20px;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
  opacity: 0.3;
}

.empty-text {
  font-size: 15px;
  color: #C7C7CC;
}

