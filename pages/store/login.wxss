/* pages/store/login.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  position: relative;
  z-index: 100;
}

.nav-left, .nav-right {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 32px;
  color: #FFFFFF;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.5px;
}

/* 内容区域 */
.content {
  flex: 1;
  padding: 40px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  max-width: 400px;
  background: #FFFFFF;
  border-radius: 20px;
  padding: 40px 24px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.login-title {
  font-size: 22px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 8px;
}

.login-subtitle {
  font-size: 14px;
  color: #86868B;
  margin-bottom: 32px;
}

/* 表单项 */
.form-item {
  width: 100%;
  margin-bottom: 20px;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #86868B;
  margin-bottom: 8px;
  padding-left: 4px;
}

/* 选择器 */
.picker-value {
  width: 100%;
  height: 48px;
  background: #F5F5F7;
  border-radius: 12px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 15px;
  color: #1D1D1F;
  flex: 1;
}

.picker-text.placeholder {
  color: #C7C7CC;
}

.picker-arrow {
  font-size: 20px;
  color: #C7C7CC;
}

/* 密码输入框 */
.password-input {
  width: 100%;
  height: 48px;
  background: #F5F5F7;
  border-radius: 12px;
  padding: 0 16px;
  font-size: 15px;
  color: #1D1D1F;
  box-sizing: border-box;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 50px;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 25px;
  color: #FFFFFF;
  font-size: 17px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12px;
  box-shadow: 0 4px 16px rgba(102, 126, 234, 0.4);
  border: none;
}

.login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 提示信息 */
.tip-section {
  margin-top: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12px;
}

.tip-icon {
  font-size: 16px;
}

.tip-text {
  font-size: 13px;
  color: #FFFFFF;
}

