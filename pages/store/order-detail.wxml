<view class="page">
  <!-- 顶部导航栏 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">订单详情</view>
    <view class="nav-right"></view>
  </view>

  <!-- 快捷操作栏 -->
  <view class="quick-actions" wx:if="{{quickActions.length > 0}}">
    <button 
      class="quick-action-btn {{item.type}}" 
      wx:for="{{quickActions}}" 
      wx:key="type"
      bindtap="onQuickAction"
      data-action="{{item.type}}"
    >
      {{item.text}}
    </button>
  </view>

  <!-- 内容区域 -->
  <scroll-view class="content" scroll-y>
    <!-- 订单状态 -->
    <view class="status-section">
      <text class="status-label">当前状态</text>
      <text class="status-value {{orderStatus}}">{{orderStatusText}}</text>
    </view>

    <!-- 商品信息 -->
    <view class="section">
      <view class="section-title">商品信息</view>
      <view class="product-card">
        <image class="product-image" src="{{productImage}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{productName}}</text>
          <view class="product-tags">
            <text class="tag">{{mainCategory}}</text>
            <text class="tag">{{subCategory}}</text>
          </view>
          <text class="product-accessories" wx:if="{{accessoriesText !== '无'}}">
            配件：{{accessoriesText}}
          </text>
        </view>
      </view>
    </view>

    <!-- 租赁信息 -->
    <view class="section">
      <view class="section-title">租赁信息</view>
      <view class="info-row">
        <text class="info-label">租赁时间</text>
        <text class="info-value">{{rentalStartDate}} ~ {{rentalEndDate}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">租赁天数</text>
        <text class="info-value">{{rentalDays}}天</text>
      </view>
      <view class="info-row">
        <text class="info-label">取货地点</text>
        <text class="info-value">{{storeName}}</text>
      </view>
    </view>

    <!-- 费用信息 -->
    <view class="section">
      <view class="section-title">费用信息</view>
      <view class="info-row">
        <text class="info-label">器材租金</text>
        <text class="info-value">£{{equipmentPrice}}</text>
      </view>
      <view class="info-row" wx:if="{{accessoriesPrice > 0}}">
        <text class="info-label">配件费用</text>
        <text class="info-value">£{{accessoriesPrice}}</text>
      </view>
      <view class="info-row" wx:if="{{couponDiscount > 0}}">
        <text class="info-label">优惠券</text>
        <text class="info-value discount">-£{{couponDiscount}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">押金</text>
        <text class="info-value">£{{deposit}}</text>
      </view>
      <view class="info-row total">
        <text class="info-label">总计</text>
        <text class="info-value">£{{totalAmount}}</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value orderId">{{orderId}}</text>
      </view>
      <view class="info-row" wx:if="{{createTime}}">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{createTime}}</text>
      </view>
      <view class="info-row" wx:if="{{payTime}}">
        <text class="info-label">支付时间</text>
        <text class="info-value">{{payTime}}</text>
      </view>
    </view>
  </scroll-view>
</view>

