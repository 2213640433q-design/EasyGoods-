<view class="page">
  <!-- 顶部导航栏 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-title">确认取件</view>
    <view class="nav-right"></view>
  </view>

  <!-- 内容区域 -->
  <scroll-view class="content" scroll-y enable-back-to-top>
    <!-- 扫码/输入区域 -->
    <view class="scan-section">
      <view class="scan-icon">📦</view>
      <text class="scan-title">确认取件</text>
      <text class="scan-subtitle">扫描二维码或输入订单号</text>
      
      <!-- 扫码按钮 -->
      <button class="scan-btn" bindtap="onScanQRCode">
        <text class="btn-icon">📷</text>
        <text class="btn-text">扫描二维码</text>
      </button>
      
      <!-- 分隔线 -->
      <view class="divider-line">
        <view class="divider-text">或</view>
      </view>
      
      <!-- 手动输入订单号 -->
      <view class="input-section">
        <input 
          class="order-input" 
          placeholder="请输入订单号" 
          value="{{inputOrderId}}"
          bindinput="onOrderIdInput"
          maxlength="30"
        />
        <button class="search-btn" bindtap="onSearchOrder">
          查询订单
        </button>
      </view>
    </view>

    <!-- 订单信息确认区域 -->
    <view class="order-confirm-section" wx:if="{{orderInfo}}">
      <view class="section-title">订单信息</view>
      
      <view class="order-card">
        <!-- 商品信息 -->
        <view class="product-row">
          <image class="product-image" src="{{orderInfo.productImage}}" mode="aspectFill" />
          <view class="product-info">
            <text class="product-name">{{orderInfo.productName}}</text>
            <text class="product-subtitle">{{orderInfo.productSubtitle}}</text>
          </view>
        </view>

        <!-- 详细信息 -->
        <view class="info-row">
          <text class="info-label">订单号</text>
          <text class="info-value">{{orderInfo.orderId}}</text>
        </view>
        
        <view class="info-row">
          <text class="info-label">租期</text>
          <text class="info-value">{{orderInfo.rentalDays}}天</text>
        </view>
        
        <view class="info-row">
          <text class="info-label">租赁时间</text>
          <text class="info-value">{{orderInfo.rentalStartDate}} 至 {{orderInfo.rentalEndDate}}</text>
        </view>
        
        <view class="info-row">
          <text class="info-label">取货地点</text>
          <text class="info-value">{{orderInfo.pickupLocation}}</text>
        </view>
        
        <view class="info-row" wx:if="{{orderInfo.accessoriesText !== '无'}}">
          <text class="info-label">付费配件</text>
          <text class="info-value">{{orderInfo.accessoriesText}}</text>
        </view>
      </view>

      <!-- 确认按钮（根据二维码类型显示不同文案） -->
      <button class="confirm-btn" bindtap="onConfirmAction">
        <text wx:if="{{qrType === 'pickup'}}">✅ 确认已取件</text>
        <text wx:elif="{{qrType === 'return'}}">✅ 确认已归还</text>
        <text wx:else>✅ 确认操作</text>
      </button>
    </view>
  </scroll-view>
</view>

