/* pages/store/order-detail.wxss */
.page {
  height: 100vh;
  background: #F5F5F7;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部导航栏 */
.topbar {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12px;
  position: relative;
  z-index: 100;
}

.nav-left, .nav-right {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 32px;
  color: #FFFFFF;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.5px;
}

/* 快捷操作栏 */
.quick-actions {
  background: #FFFFFF;
  padding: 12px 16px;
  display: flex;
  gap: 12px;
  border-bottom: 1px solid #E5E5EA;
}

.quick-action-btn {
  flex: 1;
  height: 44px;
  border-radius: 22px;
  font-size: 15px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.2s;
  white-space: nowrap; /* 文字不换行 */
  line-height: 1.2;
}

.quick-action-btn::after {
  border: none; /* 去除按钮默认边框 */
}

.quick-action-btn:active {
  transform: scale(0.96);
}

.quick-action-btn.confirm-pickup,
.quick-action-btn.confirm-return,
.quick-action-btn.primary {
  background: linear-gradient(135deg, #2E5A9B 0%, #1E3A5F 100%);
  color: #FFFFFF !important;
  box-shadow: 0 4px 12px rgba(46, 90, 155, 0.3);
}

.quick-action-btn.confirm-ok,
.quick-action-btn.success {
  background: linear-gradient(135deg, #34C759 0%, #2DB04F 100%);
  color: #FFFFFF !important;
  box-shadow: 0 4px 12px rgba(52, 199, 89, 0.3);
}

.quick-action-btn.confirm-damaged,
.quick-action-btn.warning {
  background: #FFFFFF;
  color: #FF3B30 !important;
  border: 2px solid #FF3B30;
}

/* 内容区域 */
.content {
  flex: 1;
  padding: 16px;
  box-sizing: border-box;
}

/* 订单状态 */
.status-section {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.status-label {
  font-size: 13px;
  color: #86868B;
}

.status-value {
  font-size: 24px;
  font-weight: 600;
}

.status-value.pending {
  color: #F57C00;
}

.status-value.paid {
  color: #2E5A9B;
}

.status-value.picked {
  color: #388E3C;
}

.status-value.checking {
  color: #F57F17;
}

.status-value.completed {
  color: #388E3C; /* 绿色，表示完成 */
}

.status-value.damaged {
  color: #FF3B30; /* 红色，表示折损 */
}

/* 通用区块 */
.section {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 16px;
}

/* 商品卡片 */
.product-card {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.product-image {
  width: 80px;
  height: 80px;
  border-radius: 10px;
  background: #F5F5F7;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.product-name {
  font-size: 16px;
  font-weight: 500;
  color: #1D1D1F;
}

.product-tags {
  display: flex;
  gap: 6px;
}

.tag {
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 11px;
  background: #F5F5F7;
  color: #86868B;
}

.product-accessories {
  font-size: 12px;
  color: #86868B;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #F5F5F7;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row.total {
  border-top: 2px solid #F5F5F7;
  padding-top: 14px;
  margin-top: 4px;
}

.info-label {
  font-size: 14px;
  color: #86868B;
}

.info-row.total .info-label {
  font-size: 15px;
  color: #1D1D1F;
  font-weight: 500;
}

.info-value {
  font-size: 14px;
  color: #1D1D1F;
  text-align: right;
}

.info-value.orderId {
  font-family: 'Courier New', monospace;
  font-size: 12px;
}

.info-value.discount {
  color: #FF3B30;
}

.info-row.total .info-value {
  font-size: 18px;
  color: #2E5A9B;
  font-weight: 600;
}

