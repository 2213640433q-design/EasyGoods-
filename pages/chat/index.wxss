page { height: 100vh; background:#F5F5F5; }
.navbar { position: fixed; top:0; left:0; right:0; height:44px; background:#FFF; border-bottom:1px solid #E5E5E5; display:flex; align-items:center; justify-content:space-between; padding:0 16px; z-index:1000; }
.nav-left { 
  display: flex; 
  align-items: center; 
  gap: 8px;
}
.nav-right { width: 60px; display: flex; justify-content: flex-end; align-items: center; }
.nav-title { flex:1; text-align:center; font-size:16px; font-weight:600; color:#1D1D1F; }
.back-icon { font-size:28px; color:#1D1D1F; }
.role-switch { 
  font-size: 12px; 
  color: #4A6FA5; 
  background: #E8F4FF;
  padding: 4px 8px;
  border-radius: 12px;
}

.product-card { 
  position: fixed;
  top: calc(44px + env(safe-area-inset-top));
  left: 0;
  right: 0;
  background:#FFF; 
  padding:12px 16px; 
  display:flex; 
  align-items:flex-start; 
  border-bottom:1px solid #F2F2F7; 
  flex-shrink:0; 
  min-height:80px;
  z-index: 999;
}

/* 交易预约组件（置顶悬浮） */
.appointment-widget {
  position: fixed;
  top: calc(44px + env(safe-area-inset-top) + 110px);
  left: 12px;
  right: 12px;
  background: #FFF;
  border-radius: 12px;
  padding: 14px;
  z-index: 998;
  box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  border: 1px solid #E5E7EB;
}

.widget-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.widget-title {
  font-size: 15px;
  font-weight: 600;
  color: #1D1D1F;
}

.status-badge {
  font-size: 12px;
  padding: 3px 10px;
  border-radius: 12px;
  font-weight: 500;
}

.status-pending {
  background: #FFF3E0;
  color: #F57C00;
}

.status-confirmed {
  background: #E8F5E9;
  color: #388E3C;
}

.status-rejected {
  background: #FFEBEE;
  color: #D32F2F;
}

.widget-content {
  margin-bottom: 12px;
}

.info-line {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.info-line:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 16px;
  margin-right: 8px;
  flex-shrink: 0;
}

.info-text {
  font-size: 14px;
  color: #1D1D1F;
  flex: 1;
}

.modify-count {
  font-size: 12px;
  color: #8E8E93;
  margin-top: 8px;
  text-align: right;
}

.widget-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #F2F2F7;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 8px 12px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
}

.btn-confirm {
  background: #4A6FA5;
  color: #FFF;
}

.btn-reject {
  background: #F2F2F7;
  color: #8E8E93;
}

.btn-adjust {
  background: #E8F4FF;
  color: #4A6FA5;
}

.action-btn-disabled {
  flex: 1;
  text-align: center;
  padding: 8px 12px;
  border-radius: 8px;
  font-size: 14px;
  background: #F2F2F7;
  color: #C7C7CC;
}

.widget-result {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #F2F2F7;
  text-align: center;
}

.result-text {
  font-size: 14px;
  font-weight: 500;
  color: #388E3C;
}

.result-text.reject {
  color: #D32F2F;
}
.product-image { width:80px; height:80px; border-radius:8px; flex-shrink:0; margin-right:12px; }
.product-info { flex:1; display:flex; flex-direction:column; min-width:0; }
.product-name { font-size:14px; color:#1D1D1F; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; line-height:20px; margin-bottom:4px; }
.product-price { display:flex; align-items:baseline; margin-bottom:4px; }
.price-symbol { font-size:12px; color:#FF3B30; margin-right:2px; }
.price-number { font-size:16px; color:#FF3B30; font-weight:600; }
.pickup-method { font-size:12px; color:#1D1D1F; font-weight:500; margin-bottom:4px; }
.city-pickup { font-size:12px; color:#8E8E93; }
.buy-button { width:80px; height:32px; background:linear-gradient(135deg,#FF6B35 0%, #FF4500 100%); border-radius:16px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-left:12px; align-self:center; box-shadow:0 2px 6px rgba(255,69,0,.18); }
.buy-button text { color:#FFF; font-size:14px; }

.messages-scroll { 
  flex:1; 
  position:fixed; 
  top: calc(44px + env(safe-area-inset-top) + 110px); 
  left:0; 
  right:0; 
  bottom: 56px;
  padding:12px 16px;
  padding-top: 200px; /* 为预约组件留出空间 */
  overflow-y: auto;
}
.message-item { display:flex; width:100%; margin-bottom:16px; align-items:flex-start; }

/* 系统消息 */
.system-message {
  width: 100%;
  display: flex;
  justify-content: center;
  margin: 12px 0;
}
.system-text {
  font-size: 12px;
  color: #8E8E93;
  background: #F2F2F7;
  padding: 4px 12px;
  border-radius: 12px;
}

.spacer { flex:1; min-width:20px; }
.msg-avatar { width:36px; height:36px; border-radius:18px; flex-shrink:0; }
.left-avatar { margin-right:10px; }
.right-avatar { margin-left:10px; }
.message-content { display:flex; flex-direction:column; max-width:70%; min-width:0; }
.message-left-content { align-items:flex-start; }
.message-right-content { align-items:flex-end; }
.message-bubble { padding:10px 14px; border-radius:12px; margin-bottom:4px; max-width:100%; }
.bubble-left { background:#FFF; border-top-left-radius:4px; }
.bubble-right { background:#4A6FA5; border-top-right-radius:4px; }
.bubble-right .message-text { color:#FFF; }
.message-text { font-size:15px; color:#1D1D1F; line-height:1.5; }
.message-time { font-size:11px; color:#8E8E93; padding:0 4px; margin-top:2px; }
.bottom-placeholder { height:20px; }

.input-bar { position:fixed; left:0; right:0; bottom:0; background:#FFF; border-top:1px solid #E5E5E5; display:flex; align-items:center; padding:8px 12px; z-index:1000; }

/* 预约按钮 */
.appointment-btn { 
  width:32px; 
  height:32px; 
  display:flex; 
  align-items:center; 
  justify-content:center; 
  margin-right:8px;
  flex-shrink: 0;
}
.icon-emoji {
  font-size: 22px;
}

.voice-btn, .emoji-btn, .add-btn { width:32px; height:32px; display:flex; align-items:center; justify-content:center; margin-right:8px; }
.add-btn { margin-right:0; }
.input-box { flex:1; background:#F2F2F7; border-radius:18px; padding:0 14px; min-width:0; margin-right:8px; }
.input-field { width:100%; height:36px; font-size:15px; background:transparent; }

/* 快捷预约面板 */
.appointment-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 56px;
  background: #FFF;
  border-top: 1px solid #E5E5E5;
  padding: 16px;
  z-index: 999;
  box-shadow: 0 -2px 8px rgba(0,0,0,0.08);
}

.panel-title {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 16px;
}

.panel-section {
  margin-bottom: 12px;
}

.section-label {
  font-size: 13px;
  color: #8E8E93;
  margin-bottom: 6px;
}

.picker-value {
  background: #F2F2F7;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 14px;
  color: #1D1D1F;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  color: #8E8E93;
  font-size: 16px;
}

.panel-send-btn {
  background: #4A6FA5;
  color: #FFF;
  border-radius: 8px;
  padding: 12px;
  text-align: center;
  font-size: 15px;
  font-weight: 500;
  margin-top: 16px;
}

